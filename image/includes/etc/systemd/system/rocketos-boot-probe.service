[Unit]
Description=RocketOS Phase 3 Boot Success Probe
Documentation=https://github.com/RyanEid06/RocketOS
After=rocketos-graphical-session.service
Wants=rocketos-graphical-session.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/rocketos-boot-probe
StandardOutput=journal+console
StandardError=journal+console
TimeoutSec=220
ExecStopPost=/bin/sh -c 'if [ "$$EXIT_STATUS" != "0" ] && [ "$$EXIT_STATUS" != "" ]; then echo "[SYSTEMD] rocketos-boot-probe.service FAILED with exit status $$EXIT_STATUS" > /dev/ttyS0 2>/dev/null || true; fi'

[Install]
WantedBy=graphical.target

