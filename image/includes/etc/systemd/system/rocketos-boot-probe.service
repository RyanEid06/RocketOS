[Unit]
Description=RocketOS Phase 2 Boot Success Probe
Documentation=https://github.com/RyanEid06/RocketOS
DefaultDependencies=no
After=multi-user.target graphical.target rocketos-graphical-session.service systemd-journald.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/rocketos-boot-probe
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=graphical.target
