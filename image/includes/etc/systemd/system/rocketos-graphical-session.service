[Unit]
Description=RocketOS Phase 3 Graphical Session (Cage + rocket-shell-host)
Documentation=https://github.com/RyanEid06/RocketOS
After=systemd-user-sessions.service systemd-logind.service dbus.service
Wants=systemd-logind.service dbus.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=rocket
Group=rocket
PAMName=login
# RocketOS graphical apps are fully unprivileged.
# Explicitly clear capabilities after PAM setup so WebKitGTK bubblewrap
# receives the capability-free process environment it requires.
CapabilityBoundingSet=
AmbientCapabilities=
Environment=HOME=/home/rocket
Environment=USER=rocket
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/rocket
TTYPath=/dev/tty1
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
ExecStart=/usr/local/bin/rocketos-session
Restart=always
RestartSec=2
RestartPreventExitStatus=78
TimeoutStopSec=10

[Install]
WantedBy=graphical.target
