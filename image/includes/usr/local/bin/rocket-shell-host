#!/usr/bin/env python3
"""
RocketOS Phase 3 — Native Shell Host (rocket-shell-host)
GTK4 + WebKitGTK 6.0 desktop host runtime providing the typed JS/native bridge
for the unprivileged Wayland (Cage) graphical session.
"""

import sys
import os
import json
import time
import signal
import platform
import traceback

# Establish runtime marker and logging paths under unprivileged XDG_RUNTIME_DIR
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
STATE_FILE = os.path.join(RUNTIME_DIR, "rocketos-shell-host-state")
HOST_LOG_FILE = os.path.join(RUNTIME_DIR, "rocketos-shell-host.log")
ALIVE_MARKER = os.path.join(RUNTIME_DIR, "rocketos-shell-host-alive")
UI_LOADED_MARKER = os.path.join(RUNTIME_DIR, "rocketos-ui-loaded")
BRIDGE_PING_MARKER = os.path.join(RUNTIME_DIR, "rocketos-bridge-ping-ok")
WEBKIT_ERROR_FILE = os.path.join(RUNTIME_DIR, "rocketos-webkit-error")

def log(msg: str):
    """Timestamped logging to stdout and dedicated host log file."""
    timestamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    formatted = f"[{timestamp}] [rocket-shell-host] {msg}"
    print(formatted, flush=True)
    try:
        os.makedirs(RUNTIME_DIR, exist_ok=True)
        with open(HOST_LOG_FILE, "a") as f:
            f.write(formatted + "\n")
    except Exception:
        # Logging helper must never crash the host
        pass

def write_state(state: str, detail: str = ""):
    """Atomically records current host lifecycle boundary to state file."""
    timestamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    content = f"TIMESTAMP_UTC={timestamp}\nPID={os.getpid()}\nSTATE={state}\n"
    if detail:
        content += f"DETAIL={detail}\n"
    log(f"STATE_TRANSITION -> {state}{(': ' + detail) if detail else ''}")
    try:
        os.makedirs(RUNTIME_DIR, exist_ok=True)
        tmp_path = f"{STATE_FILE}.tmp.{os.getpid()}"
        with open(tmp_path, "w") as f:
            f.write(content)
        os.replace(tmp_path, STATE_FILE)
    except Exception as e:
        # Never crash from state writing failure
        try:
            print(f"[{timestamp}] [rocket-shell-host] ERROR writing state file: {e}", file=sys.stderr, flush=True)
        except Exception:
            pass

def record_fatal_exception(exc: Exception, context: str = ""):
    """Captures unhandled initialization exceptions with complete traceback."""
    tb = traceback.format_exc()
    exc_type = type(exc).__name__
    exc_msg = str(exc)
    detail = f"{exc_type}: {exc_msg} in {context}\n{tb}".strip()
    log(f"FATAL EXCEPTION in {context}: {exc_type}: {exc_msg}\n{tb}")
    write_state("HOST_FATAL_EXCEPTION", detail)
    try:
        os.makedirs(RUNTIME_DIR, exist_ok=True)
        with open(WEBKIT_ERROR_FILE, "w") as f:
            f.write(f"HOST_FATAL_EXCEPTION: {exc_type}: {exc_msg}\nCONTEXT: {context}\nPID: {os.getpid()}\nTRACEBACK:\n{tb}\n")
    except Exception as e:
        log(f"Notice: Failed writing fatal exception to {WEBKIT_ERROR_FILE}: {e}")

def cleanup_stale_markers():
    """Removes stale session markers on startup."""
    for path in (UI_LOADED_MARKER, BRIDGE_PING_MARKER, WEBKIT_ERROR_FILE):
        try:
            if os.path.exists(path):
                os.remove(path)
                log(f"Removed stale marker/error file: {path}")
        except Exception as e:
            log(f"Notice: Failed removing marker {path}: {e}")

def create_runtime_marker(path: str):
    """Creates a deterministic marker file containing the current host PID."""
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(f"{os.getpid()}\n")
        log(f"Runtime marker created: {path} (PID: {os.getpid()})")
    except Exception as e:
        log(f"ERROR: Runtime marker creation failure at {path}: {e}")

# Clean any prior session markers immediately before recording start
for p in (ALIVE_MARKER, UI_LOADED_MARKER, BRIDGE_PING_MARKER, WEBKIT_ERROR_FILE):
    try:
        if os.path.exists(p):
            os.remove(p)
    except Exception:
        pass

# 1. PROCESS_STARTED boundary
write_state("PROCESS_STARTED", f"PID={os.getpid()}, PPID={os.getppid()}, UID={os.getuid()}, args={sys.argv}")
log(f"Host process start: PID={os.getpid()}, PPID={os.getppid()}, UID={os.getuid()}, args={sys.argv}")

# 2. GI_IMPORT_OK boundary
try:
    import gi
    gi.require_version('Gtk', '4.0')
    gi.require_version('WebKit', '6.0')
    from gi.repository import Gtk, WebKit, GLib, Gio
    gtk_ver = f"{Gtk.get_major_version()}.{Gtk.get_minor_version()}.{Gtk.get_micro_version()}"
    wk_ver = f"{WebKit.get_major_version()}.{WebKit.get_minor_version()}.{WebKit.get_micro_version()}"
    log(f"GTK import success: GTK {gtk_ver}, WebKitGTK {wk_ver}")
    write_state("GI_IMPORT_OK", f"GTK={gtk_ver}, WebKitGTK={wk_ver}")
except Exception as err:
    record_fatal_exception(err, "gi_import")
    sys.stderr.write(f"FATAL: Required GObject libraries not found: {err}\n")
    sys.stderr.flush()
    sys.exit(1)

DIAGNOSTIC_DIR = "/usr/share/rocketos/diagnostic"
DIAGNOSTIC_URL = f"file://{DIAGNOSTIC_DIR}/index.html"
SUPPORTED_PROTOCOL_VERSION = 1
MAX_REQUEST_SIZE = 65536  # 64 KB limit to prevent memory exhaustion

def get_os_release_dict():
    res = {}
    for p in ("/etc/os-release", "/usr/lib/os-release"):
        if os.path.exists(p):
            try:
                with open(p, "r") as f:
                    for line in f:
                        line = line.strip()
                        if "=" in line and not line.startswith("#"):
                            k, v = line.split("=", 1)
                            res[k] = v.strip('"\'')
                break
            except Exception:
                pass
    return res

class RocketShellHostApp(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id="org.rocketos.ShellHost",
            flags=Gio.ApplicationFlags.NON_UNIQUE
        )
        self.window = None
        self.webview = None
        self.user_content_manager = None
        self.first_ping_received = False
        self.load_failed = False
        self.last_load_error = None

    def do_activate(self):
        try:
            # 5. GTK_ACTIVATE_ENTER boundary
            write_state("GTK_ACTIVATE_ENTER")
            create_runtime_marker(ALIVE_MARKER)
            log("Host activation requested: initializing RocketOS Shell Host (GTK4 + WebKitGTK 6.0)...")
            cleanup_stale_markers()

            if not self.window:
                # 6. Acquire default WebContext and configure sandbox BEFORE any WebView is created
                log("Default WebContext acquired.")
                default_context = WebKit.WebContext.get_default()
                default_context.add_path_to_sandbox(DIAGNOSTIC_DIR, True)
                log(f"WebKit sandbox path added: {DIAGNOSTIC_DIR} (read-only)")
                write_state("WEB_CONTEXT_READY", f"sandbox_path={DIAGNOSTIC_DIR}")

                log("Creating GTK4 ApplicationWindow (1280x800 fullscreen)...")
                self.window = Gtk.ApplicationWindow(application=self, title="RocketOS Shell Host")
                self.window.set_default_size(1280, 800)
                self.window.fullscreen()

                # 7. Initialize WebKitGTK 6.0 UserContentManager
                self.user_content_manager = WebKit.UserContentManager()
                log("UserContentManager created.")
                write_state("CONTENT_MANAGER_CREATED")

                # Connect signal BEFORE registering handler to prevent race conditions
                self.user_content_manager.connect(
                    "script-message-received::rocketBridge",
                    self.on_script_message
                )

                # 8. Register bridge message handler
                reg_ok = False
                try:
                    reg_ok = self.user_content_manager.register_script_message_handler("rocketBridge")
                    log(f"Bridge message-handler 'rocketBridge' registered: result={reg_ok}")
                except TypeError:
                    try:
                        reg_ok = self.user_content_manager.register_script_message_handler("rocketBridge", None)
                        log(f"Bridge message-handler 'rocketBridge' registered: result={reg_ok}")
                    except Exception as e2:
                        log(f"ERROR registering bridge message-handler 'rocketBridge' (2-arg): {e2}")
                except Exception as e:
                    log(f"ERROR registering bridge message-handler 'rocketBridge': {e}")
                write_state("BRIDGE_HANDLER_REGISTERED", f"handler=rocketBridge result={reg_ok}")

                # 9. Configure WebKit settings
                settings = WebKit.Settings()
                settings.set_enable_javascript(True)
                settings.set_allow_file_access_from_file_urls(True)
                settings.set_enable_developer_extras(False)
                settings.set_allow_universal_access_from_file_urls(False)
                settings.set_enable_webgl(False)

                # Force software rasterization in virtualized environments
                if hasattr(WebKit, 'HardwareAccelerationPolicy') and hasattr(settings, 'set_hardware_acceleration_policy'):
                    settings.set_hardware_acceleration_policy(WebKit.HardwareAccelerationPolicy.NEVER)
                write_state("SETTINGS_CREATED")

                # 10. Construct WebKitGTK 6.0 WebView using strict GObject construct properties
                write_state("WEBVIEW_CONSTRUCTION_ENTER")
                log("Verifying WebKitGTK 6.0 WebView construct properties via GI introspection...")

                available_props = []
                try:
                    if hasattr(WebKit.WebView, "list_properties"):
                        available_props = [p.name for p in WebKit.WebView.list_properties()]
                except Exception as prop_err:
                    log(f"Notice: WebKit.WebView.list_properties() inspection notice: {prop_err}")

                log(f"WebKit.WebView available properties: {', '.join(sorted(available_props)) if available_props else '(none listed)'}")

                required_props = ["user-content-manager", "settings", "network-session"]
                if available_props:
                    missing_props = [
                        rp for rp in required_props
                        if rp not in available_props and rp.replace("-", "_") not in available_props
                    ]
                    if missing_props:
                        raise RuntimeError(
                            f"Missing required WebKitGTK 6 construct properties: {missing_props}. "
                            f"Available properties: {available_props}"
                        )

                if not hasattr(WebKit, "NetworkSession") or not hasattr(WebKit.NetworkSession, "get_default"):
                    raise RuntimeError("WebKit.NetworkSession.get_default is not available in WebKitGTK 6 typelib")

                default_session = WebKit.NetworkSession.get_default()
                if default_session is None:
                    raise RuntimeError("WebKit.NetworkSession.get_default() returned None")

                log("Constructing WebKit.WebView with user_content_manager, settings, and network_session...")
                self.webview = WebKit.WebView(
                    user_content_manager=self.user_content_manager,
                    settings=settings,
                    network_session=default_session,
                )

                # Ensure settings are applied
                if hasattr(self.webview, "set_settings"):
                    self.webview.set_settings(settings)

                # Verify UserContentManager is bound to view
                actual_ucm = None
                if hasattr(self.webview, "get_user_content_manager"):
                    actual_ucm = self.webview.get_user_content_manager()
                ucm_matched = actual_ucm is self.user_content_manager
                log(f"WebView constructed successfully. UserContentManager verified: {ucm_matched} (instance={actual_ucm})")
                if not ucm_matched and actual_ucm is None:
                    log("Warning: WebView does not report an active UserContentManager!")

                self.webview.connect("load-changed", self.on_load_changed)
                self.webview.connect("load-failed", self.on_load_failed)
                self.webview.connect("web-process-terminated", self.on_web_process_terminated)
                write_state("WEBVIEW_CREATED")

                # 11. WINDOW_CHILD_SET
                self.window.set_child(self.webview)
                write_state("WINDOW_CHILD_SET")

                # 12. LOAD_URI_REQUESTED
                target_url = DIAGNOSTIC_URL
                if not os.path.exists(os.path.join(DIAGNOSTIC_DIR, "index.html")):
                    log(f"Warning: {DIAGNOSTIC_URL} not found on filesystem. Loading fallback.")
                    target_url = "about:blank"
                    log(f"Diagnostic URI load start (fallback): {target_url}")
                    write_state("LOAD_URI_REQUESTED", target_url)
                    self.webview.load_html(self.get_fallback_html(), "file:///")
                else:
                    log(f"Diagnostic URI load start: {target_url}")
                    write_state("LOAD_URI_REQUESTED", target_url)
                    self.webview.load_uri(target_url)

            # 13. GTK_WINDOW_PRESENTED
            self.window.present()
            log("GTK4 window presented.")
            write_state("GTK_WINDOW_PRESENTED")

        except Exception as exc:
            record_fatal_exception(exc, "do_activate")
            sys.exit(1)

    def on_load_changed(self, webview, event):
        uri = webview.get_uri() or "unknown"
        if event == WebKit.LoadEvent.STARTED:
            log(f"WebKit load started: {uri}")
            self.load_failed = False
            self.last_load_error = None
            write_state("WEBKIT_LOAD_STARTED", uri)
        elif event == WebKit.LoadEvent.REDIRECTED:
            log(f"WebKit load redirected: {uri}")
            write_state("WEBKIT_LOAD_REDIRECTED", uri)
        elif event == WebKit.LoadEvent.COMMITTED:
            log(f"Committed load: {uri}")
            write_state("WEBKIT_LOAD_COMMITTED", uri)
        elif event == WebKit.LoadEvent.FINISHED:
            log(f"WebKit load finished event: {uri}")
            write_state("WEBKIT_LOAD_FINISHED", uri)
            if self.load_failed:
                log(f"Load finished after failure; refusing to create UI_LOADED_MARKER (error: {self.last_load_error})")
            else:
                if uri == DIAGNOSTIC_URL or (uri and uri.startswith("file:///usr/share/rocketos/diagnostic/")):
                    log(f"Successful load finish: {uri}")
                    create_runtime_marker(UI_LOADED_MARKER)
                    write_state("UI_MARKER_CREATED", f"path={UI_LOADED_MARKER}")
                else:
                    log(f"Notice: WebKit finished loading non-diagnostic URI: {uri}")

    def on_load_failed(self, webview, load_event, failing_uri, error):
        self.load_failed = True
        err_msg = str(error)
        err_code = getattr(error, 'code', 'unknown')
        err_domain = getattr(error, 'domain', 'unknown')
        if hasattr(error, 'message'):
            err_msg = error.message
        self.last_load_error = f"{failing_uri}: {err_msg} (domain={err_domain}, code={err_code})"
        log(f"ERROR: WebKit page load failure for uri='{failing_uri}' (event={load_event}): {err_msg} (domain={err_domain}, code={err_code})")
        write_state("WEBKIT_LOAD_FAILED", f"uri={failing_uri} domain={err_domain} code={err_code} msg={err_msg}")
        try:
            with open(WEBKIT_ERROR_FILE, "w") as f:
                f.write(f"URI: {failing_uri}\nERROR: {err_msg}\nDOMAIN: {err_domain}\nCODE: {err_code}\nPID: {os.getpid()}\nEVENT: {load_event}\n")
            log(f"Wrote WebKit error details to {WEBKIT_ERROR_FILE}")
        except Exception as e:
            log(f"Notice: Failed writing {WEBKIT_ERROR_FILE}: {e}")
        return False

    def on_web_process_terminated(self, webview, reason):
        reason_name = str(reason)
        if hasattr(reason, 'value_name'):
            reason_name = reason.value_name
        elif hasattr(reason, 'value_nick'):
            reason_name = reason.value_nick
        log(f"ERROR: WebKit web-process-terminated: reason={reason_name} ({reason})")
        write_state("WEBKIT_PROCESS_TERMINATED", f"reason={reason_name} ({reason})")
        try:
            with open(WEBKIT_ERROR_FILE, "a") as f:
                f.write(f"WEB_PROCESS_TERMINATED: reason={reason_name} ({reason}) PID={os.getpid()}\n")
            log(f"Wrote WebKit web-process-terminated details to {WEBKIT_ERROR_FILE}")
        except Exception as e:
            log(f"Notice: Failed writing web-process-terminated to {WEBKIT_ERROR_FILE}: {e}")

    def on_script_message(self, ucm, js_result):
        val = None
        try:
            val = js_result.to_string()
        except Exception as e:
            log(f"Failed to read script message string: {e}")
            return

        # 1. Validate request payload size before parsing
        if len(val) > MAX_REQUEST_SIZE:
            log(f"Rejecting oversized message ({len(val)} bytes > {MAX_REQUEST_SIZE})")
            self.send_response_to_js({
                "version": SUPPORTED_PROTOCOL_VERSION,
                "id": "unknown",
                "type": "unknown",
                "success": False,
                "error": "Request size exceeds maximum allowed limit"
            })
            return

        # 2. Parse JSON safely without crashing host
        try:
            data = json.loads(val)
        except Exception as e:
            log(f"Malformed JSON in script message: {e}")
            self.send_response_to_js({
                "version": SUPPORTED_PROTOCOL_VERSION,
                "id": "unknown",
                "type": "unknown",
                "success": False,
                "error": f"Malformed JSON request: {e}"
            })
            return

        # 3. Validate top-level is an object
        if not isinstance(data, dict):
            log("Invalid request: top-level JSON must be an object")
            self.send_response_to_js({
                "version": SUPPORTED_PROTOCOL_VERSION,
                "id": "unknown",
                "type": "unknown",
                "success": False,
                "error": "Top-level request must be a JSON object"
            })
            return

        req_id = data.get("id")
        req_type = data.get("type")
        req_ver = data.get("version")
        payload = data.get("payload")

        # 4. Validate protocol version presence and compatibility
        if req_ver is None:
            log(f"Missing protocol version in request id={req_id}")
            self.send_response_to_js({
                "version": SUPPORTED_PROTOCOL_VERSION,
                "id": str(req_id) if req_id else "unknown",
                "type": str(req_type) if req_type else "unknown",
                "success": False,
                "error": "Missing protocol version field"
            })
            return

        if req_ver != SUPPORTED_PROTOCOL_VERSION:
            log(f"Unsupported protocol version {req_ver} (expected {SUPPORTED_PROTOCOL_VERSION})")
            self.send_response_to_js({
                "version": SUPPORTED_PROTOCOL_VERSION,
                "id": str(req_id) if req_id else "unknown",
                "type": str(req_type) if req_type else "unknown",
                "success": False,
                "error": f"Unsupported protocol version: {req_ver}. Supported version is {SUPPORTED_PROTOCOL_VERSION}."
            })
            return

        # 5. Validate id is a non-empty string
        if not isinstance(req_id, str) or not req_id.strip():
            log("Invalid request id: must be non-empty string")
            self.send_response_to_js({
                "version": SUPPORTED_PROTOCOL_VERSION,
                "id": "invalid",
                "type": str(req_type) if req_type else "unknown",
                "success": False,
                "error": "Request id must be a non-empty string"
            })
            return

        # 6. Validate type is a non-empty string
        if not isinstance(req_type, str) or not req_type.strip():
            log(f"Invalid request type in id={req_id}: must be non-empty string")
            self.send_response_to_js({
                "version": SUPPORTED_PROTOCOL_VERSION,
                "id": req_id,
                "type": "unknown",
                "success": False,
                "error": "Request type must be a non-empty string"
            })
            return

        self.dispatch_request(req_id, req_type, payload)

    def dispatch_request(self, req_id: str, req_type: str, payload):
        log(f"Bridge IPC request: type={req_type} id={req_id}")
        response = {
            "version": SUPPORTED_PROTOCOL_VERSION,
            "id": req_id,
            "type": req_type,
            "success": True,
            "data": None
        }

        try:
            if req_type == "ping":
                if not self.first_ping_received:
                    self.first_ping_received = True
                    log(f"First native bridge ping received from client (req_id={req_id})")
                    write_state("BRIDGE_PING_RECEIVED", f"req_id={req_id}")
                response["data"] = {
                    "pong": True,
                    "timestamp": int(time.time() * 1000)
                }
                # Create deterministic bridge ping runtime marker
                create_runtime_marker(BRIDGE_PING_MARKER)
                write_state("BRIDGE_MARKER_CREATED", f"path={BRIDGE_PING_MARKER}")

            elif req_type == "getSystemInfo":
                os_info = get_os_release_dict()
                response["data"] = {
                    "systemName": os_info.get("NAME", "RocketOS"),
                    "prettyName": os_info.get("PRETTY_NAME", "RocketOS 0.1 Alpha"),
                    "id": os_info.get("ID", "rocketos"),
                    "versionId": os_info.get("VERSION_ID", "0.1"),
                    "kernelUname": " ".join(platform.uname()),
                    "arch": platform.machine(),
                    "sessionType": os.environ.get("XDG_SESSION_TYPE", "wayland"),
                    "compositor": "cage",
                    "hostRuntime": "rocket-shell-host (GTK4 + WebKitGTK 6.0)",
                    "sessionUser": os.environ.get("USER", "rocket"),
                    "hostname": platform.node(),
                    "initSystem": "systemd",
                    "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                }

            elif req_type == "getBridgeVersion":
                wk_ver = f"{WebKit.get_major_version()}.{WebKit.get_minor_version()}.{WebKit.get_micro_version()}"
                gtk_ver = f"{Gtk.get_major_version()}.{Gtk.get_minor_version()}.{Gtk.get_micro_version()}"
                response["data"] = {
                    "protocolVersion": SUPPORTED_PROTOCOL_VERSION,
                    "host": "rocket-shell-host",
                    "webkitVersion": wk_ver,
                    "gtkVersion": gtk_ver
                }

            else:
                response["success"] = False
                response["error"] = f"Unknown request type: {req_type}"

        except Exception as e:
            response["success"] = False
            response["error"] = str(e)

        self.send_response_to_js(response)

    def send_response_to_js(self, response_dict):
        raw_json = json.dumps(response_dict)
        escaped_json = json.dumps(raw_json)
        script = f"if (window.__rocketBridgeReceive) {{ window.__rocketBridgeReceive({escaped_json}); }}"
        if self.webview:
            self.webview.evaluate_javascript(script, -1, None, None, None, None, None)

    def get_fallback_html(self):
        return """<!DOCTYPE html>
<html>
<head><title>RocketOS Shell Host</title><style>body { background: #0b0f19; color: #fff; font-family: sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }</style></head>
<body><h1>RocketOS Phase 3 Shell Host Active</h1></body>
</html>"""

def handle_signal(sig, frame):
    log(f"Received signal {sig}, exiting gracefully...")
    write_state("APPLICATION_EXITED", f"signal={sig}")
    sys.exit(0)

def main():
    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    try:
        log(f"Starting RocketOS Native Shell Host (Phase 3, PID: {os.getpid()})...")
        log("Constructing RocketShellHostApp (Gtk.Application)...")
        app = RocketShellHostApp()
        # 3. APPLICATION_CREATED boundary
        write_state("APPLICATION_CREATED")

        log("Gtk.Application constructed successfully; calling app.run(sys.argv)...")
        # 4. APPLICATION_RUN_ENTER boundary
        write_state("APPLICATION_RUN_ENTER")
        exit_status = app.run(sys.argv)

        log(f"RocketOS Native Shell Host exited with code {exit_status}")
        # 20. APPLICATION_EXITED boundary
        write_state("APPLICATION_EXITED", f"exit_code={exit_status}")
        sys.exit(exit_status)
    except Exception as exc:
        record_fatal_exception(exc, "main")
        sys.exit(1)

if __name__ == "__main__":
    main()
