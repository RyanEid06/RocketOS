#!/usr/bin/env python3
"""
RocketOS Phase 3 — Native Shell Host (rocket-shell-host)
GTK4 + WebKitGTK 6.0 desktop host runtime providing the typed JS/native bridge
for the unprivileged Wayland (Cage) graphical session.
"""

import sys
import os
import json
import time
import signal
import platform

# Ensure standard unprivileged path and home
if not os.environ.get("HOME"):
    os.environ["HOME"] = "/home/rocket"

try:
    import gi
    gi.require_version('Gtk', '4.0')
    gi.require_version('WebKit', '6.0')
    from gi.repository import Gtk, WebKit, GLib, Gio
except ImportError as err:
    sys.stderr.write(f"FATAL: Required GObject libraries not found: {err}\n")
    sys.exit(1)

LOG_FILE = "/var/log/rocketos-shell-host.log"
MARKER_FILE = "/var/log/rocketos-phase3.log"
DIAGNOSTIC_URL = "file:///usr/share/rocketos/diagnostic/index.html"

def log(msg: str):
    timestamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    entry = f"[{timestamp}] [rocket-shell-host] {msg}"
    print(entry, flush=True)
    try:
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        with open(LOG_FILE, "a") as f:
            f.write(entry + "\n")
    except Exception:
        pass

def emit_serial_marker(marker_name="ROCKETOS_PHASE3_GRAPHICAL_BOOT_OK"):
    """Emits the deterministic Phase 3 graphical boot success marker to serial/console."""
    os_info = get_os_release_dict()
    kernel_uname = " ".join(platform.uname())
    timestamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())

    output = f"""==================================================
{marker_name}
==================================================
SYSTEM_NAME: {os_info.get('NAME', 'RocketOS')}
PRETTY_NAME: {os_info.get('PRETTY_NAME', 'RocketOS 0.1 Alpha')}
ID: {os_info.get('ID', 'rocketos')}
VERSION_ID: {os_info.get('VERSION_ID', '0.1')}
SESSION_TYPE: {os.environ.get('XDG_SESSION_TYPE', 'wayland')}
COMPOSITOR: cage
SHELL_HOST: rocket-shell-host
RUNTIME: GTK4 + WebKitGTK 6.0
SESSION_USER: {os.environ.get('USER', 'rocket')}
SESSION_PID: {os.getpid()}
SYSTEMD_TARGET: graphical.target
NATIVE_BRIDGE: active
KERNEL_UNAME: {kernel_uname}
ARCHITECTURE: {platform.machine()}
HOSTNAME: {platform.node()}
TIMESTAMP_UTC: {timestamp}
=================================================="""

    log(f"Emitting verification marker: {marker_name}")
    print(output, flush=True)

    # Write to log file
    try:
        os.makedirs(os.path.dirname(MARKER_FILE), exist_ok=True)
        with open(MARKER_FILE, "w") as f:
            f.write(output + "\n")
    except Exception as e:
        log(f"Notice: Failed writing marker file: {e}")

    # Write directly to serial console if accessible
    for dev in ("/dev/ttyS0", "/dev/console"):
        try:
            if os.path.exists(dev) and os.access(dev, os.W_OK):
                with open(dev, "w") as sf:
                    sf.write(output + "\n")
        except Exception:
            pass

def get_os_release_dict():
    res = {}
    for p in ("/etc/os-release", "/usr/lib/os-release"):
        if os.path.exists(p):
            try:
                with open(p, "r") as f:
                    for line in f:
                        line = line.strip()
                        if "=" in line and not line.startswith("#"):
                            k, v = line.split("=", 1)
                            res[k] = v.strip('"\'')
                break
            except Exception:
                pass
    return res

class RocketShellHostApp(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id="org.rocketos.ShellHost",
            flags=Gio.ApplicationFlags.FLAGS_NONE
        )
        self.window = None
        self.webview = None
        self.user_content_manager = None

    def do_activate(self):
        log("Initializing RocketOS Shell Host window (GTK4)...")
        if not self.window:
            self.window = Gtk.ApplicationWindow(application=self, title="RocketOS Shell Host")
            self.window.set_default_size(1280, 800)
            self.window.fullscreen()

            # Initialize WebKitGTK 6.0 UserContentManager and WebView
            self.user_content_manager = WebKit.UserContentManager()
            self.user_content_manager.register_script_message_handler("rocketBridge", None)
            self.user_content_manager.connect(
                "script-message-received::rocketBridge",
                self.on_script_message
            )

            settings = WebKit.Settings()
            settings.set_enable_developer_extras(True)
            settings.set_enable_javascript(True)
            settings.set_allow_file_access_from_file_urls(True)
            settings.set_allow_universal_access_from_file_urls(True)
            settings.set_enable_webgl(True)

            self.webview = WebKit.WebView.new_with_user_content_manager(self.user_content_manager)
            self.webview.set_settings(settings)
            self.webview.connect("load-changed", self.on_load_changed)

            self.window.set_child(self.webview)

            target_url = DIAGNOSTIC_URL
            if not os.path.exists("/usr/share/rocketos/diagnostic/index.html"):
                log(f"Warning: {DIAGNOSTIC_URL} not found on filesystem. Loading embedded fallback.")
                target_url = "about:blank"
                self.webview.load_html(self.get_fallback_html(), "file:///")
            else:
                log(f"Loading diagnostic UI: {target_url}")
                self.webview.load_uri(target_url)

        self.window.present()

    def on_load_changed(self, webview, event):
        if event == WebKit.LoadEvent.FINISHED:
            log(f"Diagnostic UI loaded successfully: {webview.get_uri()}")

    def on_script_message(self, ucm, js_result):
        try:
            val = js_result.to_string()
            data = json.loads(val)
            req_id = data.get("id")
            req_type = data.get("type")
            payload = data.get("payload")
            self.dispatch_request(req_id, req_type, payload)
        except Exception as e:
            log(f"Error processing script message: {e}")

    def dispatch_request(self, req_id, req_type, payload):
        log(f"Bridge IPC request: type={req_type} id={req_id}")
        response = {"id": req_id, "type": req_type, "success": True, "data": None}

        try:
            if req_type == "ping":
                response["data"] = {
                    "pong": True,
                    "timestamp": int(time.time() * 1000)
                }

            elif req_type == "getSystemInfo":
                os_info = get_os_release_dict()
                response["data"] = {
                    "systemName": os_info.get("NAME", "RocketOS"),
                    "prettyName": os_info.get("PRETTY_NAME", "RocketOS 0.1 Alpha"),
                    "id": os_info.get("ID", "rocketos"),
                    "versionId": os_info.get("VERSION_ID", "0.1"),
                    "kernelUname": " ".join(platform.uname()),
                    "arch": platform.machine(),
                    "sessionType": os.environ.get("XDG_SESSION_TYPE", "wayland"),
                    "compositor": "cage",
                    "hostRuntime": "rocket-shell-host (GTK4 + WebKitGTK 6.0)",
                    "sessionUser": os.environ.get("USER", "rocket"),
                    "hostname": platform.node(),
                    "initSystem": "systemd",
                    "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                }

            elif req_type == "getBridgeVersion":
                wk_ver = f"{WebKit.get_major_version()}.{WebKit.get_minor_version()}.{WebKit.get_micro_version()}"
                gtk_ver = f"{Gtk.get_major_version()}.{Gtk.get_minor_version()}.{Gtk.get_micro_version()}"
                response["data"] = {
                    "protocolVersion": "1.0",
                    "host": "rocket-shell-host",
                    "webkitVersion": wk_ver,
                    "gtkVersion": gtk_ver
                }

            else:
                response["success"] = False
                response["error"] = f"Unknown request type: {req_type}"

        except Exception as e:
            response["success"] = False
            response["error"] = str(e)

        self.send_response_to_js(response)

    def send_response_to_js(self, response_dict):
        raw_json = json.dumps(response_dict)
        escaped_json = json.dumps(raw_json)
        script = f"if (window.__rocketBridgeReceive) {{ window.__rocketBridgeReceive({escaped_json}); }}"
        if self.webview:
            self.webview.evaluate_javascript(script, -1, None, None, None, None, None)

    def get_fallback_html(self):
        return """<!DOCTYPE html>
<html>
<head><title>RocketOS Shell Host</title><style>body { background: #0b0f19; color: #fff; font-family: sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }</style></head>
<body><h1>RocketOS Phase 3 Shell Host Active</h1></body>
</html>"""

def handle_signal(sig, frame):
    log(f"Received signal {sig}, exiting gracefully...")
    sys.exit(0)

def main():
    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    log("Starting RocketOS Native Shell Host (Phase 3)...")
    app = RocketShellHostApp()
    exit_status = app.run(sys.argv)
    log(f"RocketOS Native Shell Host exited with code {exit_status}")
    sys.exit(exit_status)

if __name__ == "__main__":
    main()
