#!/usr/bin/env python3
"""
RocketOS Phase 3 — Native Shell Host (rocket-shell-host)
GTK4 + WebKitGTK 6.0 desktop host runtime providing the typed JS/native bridge
for the unprivileged Wayland (Cage) graphical session.
"""

import sys
import os
import json
import time
import signal
import platform

def log(msg: str):
    timestamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    print(f"[{timestamp}] [rocket-shell-host] {msg}", flush=True)

# 1. Host process start + PID (logged before GTK imports)
log(f"Host process start: PID={os.getpid()}, PPID={os.getppid()}, UID={os.getuid()}, args={sys.argv}")

try:
    import gi
    gi.require_version('Gtk', '4.0')
    gi.require_version('WebKit', '6.0')
    from gi.repository import Gtk, WebKit, GLib, Gio
    log(f"GTK import success: GTK {Gtk.get_major_version()}.{Gtk.get_minor_version()}.{Gtk.get_micro_version()}, WebKitGTK {WebKit.get_major_version()}.{WebKit.get_minor_version()}.{WebKit.get_micro_version()}")
except ImportError as err:
    sys.stderr.write(f"FATAL: Required GObject libraries not found: {err}\n")
    sys.stderr.flush()
    sys.exit(1)

DIAGNOSTIC_URL = "file:///usr/share/rocketos/diagnostic/index.html"
SUPPORTED_PROTOCOL_VERSION = 1
MAX_REQUEST_SIZE = 65536  # 64 KB limit to prevent memory exhaustion

# Establish runtime marker paths under unprivileged XDG_RUNTIME_DIR
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
UI_LOADED_MARKER = os.path.join(RUNTIME_DIR, "rocketos-ui-loaded")
BRIDGE_PING_MARKER = os.path.join(RUNTIME_DIR, "rocketos-bridge-ping-ok")

WEBKIT_ERROR_FILE = os.path.join(RUNTIME_DIR, "rocketos-webkit-error")

def cleanup_stale_markers():
    """Removes stale session markers on startup."""
    for path in (UI_LOADED_MARKER, BRIDGE_PING_MARKER, WEBKIT_ERROR_FILE):
        try:
            if os.path.exists(path):
                os.remove(path)
                log(f"Removed stale marker/error file: {path}")
        except Exception as e:
            log(f"Notice: Failed removing marker {path}: {e}")

def create_runtime_marker(path: str):
    """Creates a deterministic marker file containing the current host PID."""
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(f"{os.getpid()}\n")
        log(f"Runtime marker created: {path} (PID: {os.getpid()})")
    except Exception as e:
        log(f"ERROR: Runtime marker creation failure at {path}: {e}")

def get_os_release_dict():
    res = {}
    for p in ("/etc/os-release", "/usr/lib/os-release"):
        if os.path.exists(p):
            try:
                with open(p, "r") as f:
                    for line in f:
                        line = line.strip()
                        if "=" in line and not line.startswith("#"):
                            k, v = line.split("=", 1)
                            res[k] = v.strip('"\'')
                break
            except Exception:
                pass
    return res

class RocketShellHostApp(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id="org.rocketos.ShellHost",
            flags=Gio.ApplicationFlags.FLAGS_NONE
        )
        self.window = None
        self.webview = None
        self.user_content_manager = None
        self.first_ping_received = False
        self.load_failed = False
        self.last_load_error = None

    def do_activate(self):
        log("Host activation requested: initializing RocketOS Shell Host (GTK4 + WebKitGTK 6.0)...")
        cleanup_stale_markers()

        if not self.window:
            log("Creating GTK4 ApplicationWindow (1280x800 fullscreen)...")
            self.window = Gtk.ApplicationWindow(application=self, title="RocketOS Shell Host")
            self.window.set_default_size(1280, 800)
            self.window.fullscreen()

            # Initialize WebKitGTK 6.0 UserContentManager and WebView
            log("Creating WebKitGTK 6.0 UserContentManager and WebView...")
            self.user_content_manager = WebKit.UserContentManager()
            try:
                reg_ok = self.user_content_manager.register_script_message_handler("rocketBridge", None)
                log(f"Bridge message-handler 'rocketBridge' registered: result={reg_ok}")
            except Exception as e:
                log(f"ERROR registering bridge message-handler 'rocketBridge': {e}")

            self.user_content_manager.connect(
                "script-message-received::rocketBridge",
                self.on_script_message
            )

            # Harden WebKitGTK settings: secure defaults for Phase 3
            settings = WebKit.Settings()
            settings.set_enable_javascript(True)
            settings.set_allow_file_access_from_file_urls(True)
            # Hardening: explicitly disable developer extras, universal access, and WebGL
            settings.set_enable_developer_extras(False)
            settings.set_allow_universal_access_from_file_urls(False)
            settings.set_enable_webgl(False)

            self.webview = WebKit.WebView.new_with_user_content_manager(self.user_content_manager)
            self.webview.set_settings(settings)
            self.webview.connect("load-changed", self.on_load_changed)
            self.webview.connect("load-failed", self.on_load_failed)

            self.window.set_child(self.webview)

            target_url = DIAGNOSTIC_URL
            if not os.path.exists("/usr/share/rocketos/diagnostic/index.html"):
                log(f"Warning: {DIAGNOSTIC_URL} not found on filesystem. Loading fallback.")
                target_url = "about:blank"
                log(f"Diagnostic URI load start (fallback): {target_url}")
                self.webview.load_html(self.get_fallback_html(), "file:///")
            else:
                log(f"Diagnostic URI load start: {target_url}")
                self.webview.load_uri(target_url)

        self.window.present()
        log("GTK4 window presented.")

    def on_load_changed(self, webview, event):
        uri = webview.get_uri() or "unknown"
        if event == WebKit.LoadEvent.STARTED:
            log(f"WebKit load started: {uri}")
            self.load_failed = False
            self.last_load_error = None
        elif event == WebKit.LoadEvent.REDIRECTED:
            log(f"WebKit load redirected: {uri}")
        elif event == WebKit.LoadEvent.COMMITTED:
            log(f"Committed load: {uri}")
        elif event == WebKit.LoadEvent.FINISHED:
            log(f"WebKit load finished event: {uri}")
            if self.load_failed:
                log(f"Load finished after failure; refusing to create UI_LOADED_MARKER (error: {self.last_load_error})")
            else:
                if uri == DIAGNOSTIC_URL or (uri and uri.startswith("file:///usr/share/rocketos/diagnostic/")):
                    log(f"Successful load finish: {uri}")
                    create_runtime_marker(UI_LOADED_MARKER)
                else:
                    log(f"Notice: WebKit finished loading non-diagnostic URI: {uri}")

    def on_load_failed(self, webview, load_event, failing_uri, error):
        self.load_failed = True
        err_msg = str(error)
        err_code = getattr(error, 'code', 'unknown')
        err_domain = getattr(error, 'domain', 'unknown')
        if hasattr(error, 'message'):
            err_msg = error.message
        self.last_load_error = f"{failing_uri}: {err_msg} (domain={err_domain}, code={err_code})"
        log(f"ERROR: WebKit page load failure for uri='{failing_uri}' (event={load_event}): {err_msg} (domain={err_domain}, code={err_code})")
        try:
            with open(WEBKIT_ERROR_FILE, "w") as f:
                f.write(f"URI: {failing_uri}\nERROR: {err_msg}\nDOMAIN: {err_domain}\nCODE: {err_code}\nPID: {os.getpid()}\nEVENT: {load_event}\n")
            log(f"Wrote WebKit error details to {WEBKIT_ERROR_FILE}")
        except Exception as e:
            log(f"Notice: Failed writing {WEBKIT_ERROR_FILE}: {e}")
        return False

    def on_script_message(self, ucm, js_result):
        val = None
        try:
            val = js_result.to_string()
        except Exception as e:
            log(f"Failed to read script message string: {e}")
            return

        # 1. Validate request payload size before parsing
        if len(val) > MAX_REQUEST_SIZE:
            log(f"Rejecting oversized message ({len(val)} bytes > {MAX_REQUEST_SIZE})")
            self.send_response_to_js({
                "version": SUPPORTED_PROTOCOL_VERSION,
                "id": "unknown",
                "type": "unknown",
                "success": False,
                "error": "Request size exceeds maximum allowed limit"
            })
            return

        # 2. Parse JSON safely without crashing host
        try:
            data = json.loads(val)
        except Exception as e:
            log(f"Malformed JSON in script message: {e}")
            self.send_response_to_js({
                "version": SUPPORTED_PROTOCOL_VERSION,
                "id": "unknown",
                "type": "unknown",
                "success": False,
                "error": f"Malformed JSON request: {e}"
            })
            return

        # 3. Validate top-level is an object
        if not isinstance(data, dict):
            log("Invalid request: top-level JSON must be an object")
            self.send_response_to_js({
                "version": SUPPORTED_PROTOCOL_VERSION,
                "id": "unknown",
                "type": "unknown",
                "success": False,
                "error": "Top-level request must be a JSON object"
            })
            return

        req_id = data.get("id")
        req_type = data.get("type")
        req_ver = data.get("version")
        payload = data.get("payload")

        # 4. Validate protocol version presence and compatibility
        if req_ver is None:
            log(f"Missing protocol version in request id={req_id}")
            self.send_response_to_js({
                "version": SUPPORTED_PROTOCOL_VERSION,
                "id": str(req_id) if req_id else "unknown",
                "type": str(req_type) if req_type else "unknown",
                "success": False,
                "error": "Missing protocol version field"
            })
            return

        if req_ver != SUPPORTED_PROTOCOL_VERSION:
            log(f"Unsupported protocol version {req_ver} (expected {SUPPORTED_PROTOCOL_VERSION})")
            self.send_response_to_js({
                "version": SUPPORTED_PROTOCOL_VERSION,
                "id": str(req_id) if req_id else "unknown",
                "type": str(req_type) if req_type else "unknown",
                "success": False,
                "error": f"Unsupported protocol version: {req_ver}. Supported version is {SUPPORTED_PROTOCOL_VERSION}."
            })
            return

        # 5. Validate id is a non-empty string
        if not isinstance(req_id, str) or not req_id.strip():
            log("Invalid request id: must be non-empty string")
            self.send_response_to_js({
                "version": SUPPORTED_PROTOCOL_VERSION,
                "id": "invalid",
                "type": str(req_type) if req_type else "unknown",
                "success": False,
                "error": "Request id must be a non-empty string"
            })
            return

        # 6. Validate type is a non-empty string
        if not isinstance(req_type, str) or not req_type.strip():
            log(f"Invalid request type in id={req_id}: must be non-empty string")
            self.send_response_to_js({
                "version": SUPPORTED_PROTOCOL_VERSION,
                "id": req_id,
                "type": "unknown",
                "success": False,
                "error": "Request type must be a non-empty string"
            })
            return

        self.dispatch_request(req_id, req_type, payload)

    def dispatch_request(self, req_id: str, req_type: str, payload):
        log(f"Bridge IPC request: type={req_type} id={req_id}")
        response = {
            "version": SUPPORTED_PROTOCOL_VERSION,
            "id": req_id,
            "type": req_type,
            "success": True,
            "data": None
        }

        try:
            if req_type == "ping":
                if not self.first_ping_received:
                    self.first_ping_received = True
                    log(f"First native bridge ping received from client (req_id={req_id})")
                response["data"] = {
                    "pong": True,
                    "timestamp": int(time.time() * 1000)
                }
                # Create deterministic bridge ping runtime marker
                create_runtime_marker(BRIDGE_PING_MARKER)

            elif req_type == "getSystemInfo":
                os_info = get_os_release_dict()
                response["data"] = {
                    "systemName": os_info.get("NAME", "RocketOS"),
                    "prettyName": os_info.get("PRETTY_NAME", "RocketOS 0.1 Alpha"),
                    "id": os_info.get("ID", "rocketos"),
                    "versionId": os_info.get("VERSION_ID", "0.1"),
                    "kernelUname": " ".join(platform.uname()),
                    "arch": platform.machine(),
                    "sessionType": os.environ.get("XDG_SESSION_TYPE", "wayland"),
                    "compositor": "cage",
                    "hostRuntime": "rocket-shell-host (GTK4 + WebKitGTK 6.0)",
                    "sessionUser": os.environ.get("USER", "rocket"),
                    "hostname": platform.node(),
                    "initSystem": "systemd",
                    "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                }

            elif req_type == "getBridgeVersion":
                wk_ver = f"{WebKit.get_major_version()}.{WebKit.get_minor_version()}.{WebKit.get_micro_version()}"
                gtk_ver = f"{Gtk.get_major_version()}.{Gtk.get_minor_version()}.{Gtk.get_micro_version()}"
                response["data"] = {
                    "protocolVersion": SUPPORTED_PROTOCOL_VERSION,
                    "host": "rocket-shell-host",
                    "webkitVersion": wk_ver,
                    "gtkVersion": gtk_ver
                }

            else:
                response["success"] = False
                response["error"] = f"Unknown request type: {req_type}"

        except Exception as e:
            response["success"] = False
            response["error"] = str(e)

        self.send_response_to_js(response)

    def send_response_to_js(self, response_dict):
        raw_json = json.dumps(response_dict)
        escaped_json = json.dumps(raw_json)
        script = f"if (window.__rocketBridgeReceive) {{ window.__rocketBridgeReceive({escaped_json}); }}"
        if self.webview:
            self.webview.evaluate_javascript(script, -1, None, None, None, None, None)

    def get_fallback_html(self):
        return """<!DOCTYPE html>
<html>
<head><title>RocketOS Shell Host</title><style>body { background: #0b0f19; color: #fff; font-family: sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }</style></head>
<body><h1>RocketOS Phase 3 Shell Host Active</h1></body>
</html>"""

def handle_signal(sig, frame):
    log(f"Received signal {sig}, exiting gracefully...")
    sys.exit(0)

def main():
    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    log(f"Starting RocketOS Native Shell Host (Phase 3, PID: {os.getpid()})...")
    log("Constructing RocketShellHostApp (Gtk.Application)...")
    app = RocketShellHostApp()
    log("Gtk.Application constructed successfully; calling app.run(sys.argv)...")
    exit_status = app.run(sys.argv)
    log(f"RocketOS Native Shell Host exited with code {exit_status}")
    sys.exit(exit_status)

if __name__ == "__main__":
    main()

