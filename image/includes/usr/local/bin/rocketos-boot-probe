#!/bin/bash
# ==============================================================================
# RocketOS Phase 3 Boot Success Probe
# Validates both system foundation and graphical session before emitting:
# ROCKETOS_PHASE2_BOOT_OK
# ROCKETOS_PHASE3_GRAPHICAL_BOOT_OK
# ==============================================================================
set -euo pipefail

TARGET_DEV="/dev/console"
[ -w "$TARGET_DEV" ] || TARGET_DEV="/dev/stderr"
[ -w "$TARGET_DEV" ] || TARGET_DEV="/dev/null"
LOG_FILE="/var/log/rocketos-boot-probe.log"
mkdir -p "$(dirname "$LOG_FILE")"

ROCKET_UID=1000
RUNTIME_DIR="/run/user/${ROCKET_UID}"
UI_LOADED_MARKER="${RUNTIME_DIR}/rocketos-ui-loaded"
BRIDGE_PING_MARKER="${RUNTIME_DIR}/rocketos-bridge-ping-ok"
STATE_FILE="${RUNTIME_DIR}/rocketos-shell-host-state"
ALIVE_MARKER="${RUNTIME_DIR}/rocketos-shell-host-alive"
HOST_LOG_FILE="${RUNTIME_DIR}/rocketos-shell-host.log"
WEBKIT_ERROR_FILE="${RUNTIME_DIR}/rocketos-webkit-error"
SANDBOX_PREFLIGHT_ERROR="${RUNTIME_DIR}/rocketos-sandbox-preflight-error"

PROBE_COMPLETED=false

# Dedicated serial-first checkpoint logger (never writes to stdout)
log_checkpoint() {
  local msg="$1"
  local ts
  ts="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  local line="[CHECKPOINT ${ts}] ${msg}"
  if [ -e /dev/ttyS0 ] && [ -w /dev/ttyS0 ]; then
    echo "${line}" > /dev/ttyS0 2>/dev/null || true
  fi
  echo "${line}" >> "${LOG_FILE}" 2>/dev/null || true
  if [ -w "${TARGET_DEV}" ]; then
    echo "${line}" > "${TARGET_DEV}" 2>/dev/null || true
  fi
}

emit_fail() {
  local reason="$1"
  local code_tag="${2:-}"
  if [[ -z "${code_tag}" ]]; then
    code_tag="$(echo "${reason}" | head -n1 | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9_' '_' | sed 's/^_//;s/_$//')"
  fi

  local fail_line="ROCKETOS_PHASE3_FAIL: ${code_tag}"
  if [ -e /dev/ttyS0 ] && [ -w /dev/ttyS0 ]; then
    echo "${fail_line}" > /dev/ttyS0 2>/dev/null || true
  fi
  echo "${fail_line}" >> "${LOG_FILE}" 2>/dev/null || true
  if [ -w "${TARGET_DEV}" ]; then
    echo "${fail_line}" > "${TARGET_DEV}" 2>/dev/null || true
  fi

  local output="==================================================
ROCKETOS_BOOT_FAIL
==================================================
FAILURE_REASON: ${reason}
FAILURE_CODE: ${code_tag}
TIMESTAMP_UTC: $(date -u '+%Y-%m-%dT%H:%M:%SZ')
=================================================="

  log_checkpoint "PHASE3_PROBE_FAIL_TRIGGERED code=${code_tag}"
  # 1. Output to serial console FIRST (unbuffered for CI test runner capture)
  if [ -e /dev/ttyS0 ] && [ -w /dev/ttyS0 ]; then
    echo "${output}" > /dev/ttyS0 2>/dev/null || true
  fi
  # 2. Append to log file
  echo "${output}" >> "${LOG_FILE}" 2>/dev/null || true
  # 3. Output to console device without risk of hanging on large output
  if [ -w "${TARGET_DEV}" ]; then
    echo "${output}" | head -n 40 > "${TARGET_DEV}" 2>/dev/null || true
  fi
  exit 1
}

# Shell error trap to ensure 'set -e' never exits silently without emitting ROCKETOS_BOOT_FAIL
trap_error_handler() {
  local exit_code=$?
  local line_no=$1
  local bash_command="$2"
  if [[ ${exit_code} -ne 0 && "${PROBE_COMPLETED}" != "true" ]]; then
    log_checkpoint "PHASE3_PROBE_ERROR line=${line_no} exit=${exit_code} cmd='${bash_command}'"
    emit_fail "Unexpected shell failure at line ${line_no} (exit code ${exit_code}, command: '${bash_command}')"
  fi
}
trap 'trap_error_handler $LINENO "$BASH_COMMAND"' ERR

# Global watchdog safety bound (Requirement 4)
# Bounds total guest probe duration to 200s (safely below host QEMU 300s timeout)
PROBE_WATCHDOG_TIMEOUT_SECS=200
(
  sleep "${PROBE_WATCHDOG_TIMEOUT_SECS}"
  if [[ ! -f /run/rocketos-boot-probe-done ]]; then
    echo "[WATCHDOG $(date -u '+%Y-%m-%dT%H:%M:%SZ')] Probe watchdog expired (${PROBE_WATCHDOG_TIMEOUT_SECS}s)" > /dev/ttyS0 2>/dev/null || true
    cat <<EOF > /dev/ttyS0 2>/dev/null || true
==================================================
ROCKETOS_BOOT_FAIL
==================================================
FAILURE_REASON: Global boot probe watchdog timed out (${PROBE_WATCHDOG_TIMEOUT_SECS}s)
TIMESTAMP_UTC: $(date -u '+%Y-%m-%dT%H:%M:%SZ')
==================================================
EOF
    kill -ALRM $$ 2>/dev/null || true
  fi
) &
WATCHDOG_PID=$!

trap_watchdog_handler() {
  emit_fail "Global boot probe watchdog timed out after ${PROBE_WATCHDOG_TIMEOUT_SECS}s"
}
trap trap_watchdog_handler SIGALRM

# ------------------------------------------------------------------------------
# Process Discovery Helpers (Defined early before any gates/calls)
# ------------------------------------------------------------------------------

# Authoritatively identify Cage PID from systemd service or exact comm
get_authoritative_cage_pid() {
  local cage_pid=""
  cage_pid="$(timeout 2s systemctl show --property=MainPID --value rocketos-graphical-session.service 2>/dev/null || true)"
  if [[ "${cage_pid}" =~ ^[0-9]+$ && ${cage_pid} -gt 1 && -d "/proc/${cage_pid}" ]]; then
    local uid=""
    if [[ -r "/proc/${cage_pid}/status" ]]; then
      while IFS=: read -r key val; do
        if [[ "${key}" == "Uid" ]]; then
          read -r uid _ <<< "${val}"
          break
        fi
      done < "/proc/${cage_pid}/status" 2>/dev/null || true
    fi
    if [[ "${uid}" == "1000" ]]; then
      local comm=""
      if [[ -r "/proc/${cage_pid}/comm" ]]; then
        read -r comm < "/proc/${cage_pid}/comm" 2>/dev/null || true
      fi
      if [[ "${comm}" == "cage" ]]; then
        echo "${cage_pid}"
        return 0
      fi
    fi
  fi

  # Fallback to exact comm 'cage' owned by rocket
  for p in $(timeout 1s pgrep -u rocket -x cage 2>/dev/null || true); do
    if [[ -d "/proc/${p}" ]]; then
      echo "${p}"
      return 0
    fi
  done

  echo ""
  return 1
}

# Authoritatively test whether a PID corresponds to rocket-shell-host
is_shell_host_process() {
  local pid="$1"
  local cage_pid="${2:-}"
  local check_ancestry="${3:-false}"

  # 1. PID exists and is greater than 1
  [[ "${pid}" =~ ^[0-9]+$ && ${pid} -gt 1 && -d "/proc/${pid}" ]] || return 1

  # 2. PID != CAGE_PID
  [[ -n "${cage_pid}" && "${pid}" == "${cage_pid}" ]] && return 1

  # 3. UID belongs to rocket (UID 1000)
  local uid=""
  if [[ -r "/proc/${pid}/status" ]]; then
    while IFS=: read -r key val; do
      if [[ "${key}" == "Uid" ]]; then
        read -r uid _ <<< "${val}"
        break
      fi
    done < "/proc/${pid}/status" 2>/dev/null || true
  fi
  if [[ "${uid}" != "1000" ]]; then
    local owner=""
    owner="$(timeout 1s ps -p "${pid}" -o user= 2>/dev/null | tr -d '[:space:]' || true)"
    [[ "${owner}" == "rocket" ]] || return 1
  fi

  # 4. Process is not Cage, bwrap, or WebKit subprocesses
  local comm=""
  if [[ -r "/proc/${pid}/comm" ]]; then
    read -r comm < "/proc/${pid}/comm" 2>/dev/null || true
  fi
  if [[ "${comm}" == "cage" || "${comm}" =~ ^WebKit || "${comm}" == "bwrap" ]]; then
    return 1
  fi

  # 5. Read command line safely (timeout-bounded)
  local cmdline=""
  if [[ -r "/proc/${pid}/cmdline" ]]; then
    cmdline="$(timeout 1s tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null || true)"
  fi
  [[ -n "${cmdline}" ]] || return 1

  # First argument / executable must NOT be cage
  local arg0="${cmdline%% *}"
  local base_arg0="${arg0##*/}"
  [[ "${base_arg0}" != "cage" ]] || return 1

  # Must NOT be WebKit or bwrap
  if [[ "${cmdline}" =~ WebKit|bwrap ]]; then
    return 1
  fi

  # Command line genuinely executes /usr/local/bin/rocket-shell-host
  if [[ "${cmdline}" != *"/usr/local/bin/rocket-shell-host"* && "${cmdline}" != *"rocket-shell-host"* ]]; then
    return 1
  fi

  # 6. Ancestry check: verify Cage in ancestry if requested (for fallback scan)
  if [[ "${check_ancestry}" == "true" && -n "${cage_pid}" && -d "/proc/${cage_pid}" ]]; then
    local curr="${pid}"
    local is_descendant=false
    for ((lvl=0; lvl<5; lvl++)); do
      local ppid=""
      if [[ -r "/proc/${curr}/status" ]]; then
        while IFS=: read -r key val; do
          if [[ "${key}" == "PPid" ]]; then
            read -r ppid _ <<< "${val}"
            break
          fi
        done < "/proc/${curr}/status" 2>/dev/null || true
      fi
      if [[ -z "${ppid}" ]]; then
        ppid="$(timeout 1s ps -p "${curr}" -o ppid= 2>/dev/null | tr -d '[:space:]' || true)"
      fi
      if [[ "${ppid}" == "${cage_pid}" ]]; then
        is_descendant=true
        break
      fi
      [[ "${ppid}" =~ ^[0-9]+$ && ${ppid} -gt 1 && -d "/proc/${ppid}" ]] || break
      curr="${ppid}"
    done
    [[ "${is_descendant}" == "true" ]] || return 1
  fi

  return 0
}

# Discover authoritative shell-host PID: inspect cgroup procs, Cage children, and rocket processes
find_shell_host_pid() {
  local cage_pid="${1:-}"
  local attempt="${2:-1}"

  log_checkpoint "HOST_DISCOVERY_ATTEMPT_START attempt=${attempt} cage_pid=${cage_pid}"

  # Step 0: Fast path - inspect state file PID if recorded and alive
  if [[ -f "${STATE_FILE}" ]]; then
    local sf_pid=""
    sf_pid="$(grep '^PID=' "${STATE_FILE}" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]' || true)"
    if [[ "${sf_pid}" =~ ^[0-9]+$ && ${sf_pid} -gt 1 ]]; then
      log_checkpoint "HOST_DISCOVERY_CHECK_STATE_FILE pid=${sf_pid}"
      if is_shell_host_process "${sf_pid}" "${cage_pid}" "false"; then
        log_checkpoint "HOST_DISCOVERY_ATTEMPT_END result=FOUND pid=${sf_pid} (from_state_file)"
        echo "${sf_pid}"
        return 0
      fi
    fi
  fi

  local candidate_pids=()

  # Step 1: Read cgroup.procs if accessible under systemd cgroup v2
  local cgroup_procs_file="/sys/fs/cgroup/system.slice/rocketos-graphical-session.service/cgroup.procs"
  if [[ -r "${cgroup_procs_file}" ]]; then
    while read -r cp; do
      [[ "${cp}" =~ ^[0-9]+$ && ${cp} -gt 1 ]] && candidate_pids+=("${cp}")
    done < "${cgroup_procs_file}" 2>/dev/null || true
  fi

  # Step 2: Read Cage direct children from /proc/${cage_pid}/task/${cage_pid}/children and pgrep
  if [[ -n "${cage_pid}" && -d "/proc/${cage_pid}" ]]; then
    local children_raw=""
    if [[ -r "/proc/${cage_pid}/task/${cage_pid}/children" ]]; then
      children_raw="$(cat "/proc/${cage_pid}/task/${cage_pid}/children" 2>/dev/null || true)"
    fi
    if [[ -z "${children_raw// /}" ]]; then
      children_raw="$(timeout 1s pgrep -P "${cage_pid}" 2>/dev/null | tr '\n' ' ' || true)"
    fi
    for c in ${children_raw}; do
      [[ "${c}" =~ ^[0-9]+$ ]] && candidate_pids+=("${c}")
    done
  fi

  # Step 3: Check pgrep for rocket-shell-host
  for hp in $(timeout 1s pgrep -u rocket -f rocket-shell-host 2>/dev/null || true); do
    [[ "${hp}" =~ ^[0-9]+$ ]] && candidate_pids+=("${hp}")
  done

  # Deduplicate primary candidates
  local dedup_candidates=()
  for c in "${candidate_pids[@]}"; do
    [[ "${c}" == "${cage_pid}" ]] && continue
    local seen=false
    for sc in "${dedup_candidates[@]}"; do
      if [[ "${sc}" == "${c}" ]]; then
        seen=true
        break
      fi
    done
    [[ "${seen}" == "true" ]] || dedup_candidates+=("${c}")
  done

  log_checkpoint "HOST_DISCOVERY_PRIMARY_CANDIDATES count=${#dedup_candidates[@]} pids='${dedup_candidates[*]:-none}'"

  # Validate candidates
  for child in "${dedup_candidates[@]}"; do
    log_checkpoint "HOST_DISCOVERY_VALIDATE_PID pid=${child} START"
    if is_shell_host_process "${child}" "${cage_pid}" "false"; then
      log_checkpoint "HOST_DISCOVERY_VALIDATE_PID pid=${child} END result=MATCH"
      log_checkpoint "HOST_DISCOVERY_ATTEMPT_END result=FOUND pid=${child}"
      echo "${child}"
      return 0
    fi
    log_checkpoint "HOST_DISCOVERY_VALIDATE_PID pid=${child} END result=NO_MATCH"
  done

  # Step 4: Check 2nd-level descendants
  local descendant_pids=()
  for child in "${dedup_candidates[@]}"; do
    if [[ -d "/proc/${child}" ]]; then
      local sub_children=""
      if [[ -r "/proc/${child}/task/${child}/children" ]]; then
        sub_children="$(cat "/proc/${child}/task/${child}/children" 2>/dev/null || true)"
      fi
      if [[ -z "${sub_children// /}" ]]; then
        sub_children="$(timeout 1s pgrep -P "${child}" 2>/dev/null | tr '\n' ' ' || true)"
      fi
      for sc in ${sub_children}; do
        [[ "${sc}" =~ ^[0-9]+$ ]] && descendant_pids+=("${sc}")
      done
    fi
  done

  for desc in "${descendant_pids[@]}"; do
    log_checkpoint "HOST_DISCOVERY_VALIDATE_PID pid=${desc} START (descendant)"
    if is_shell_host_process "${desc}" "${cage_pid}" "false"; then
      log_checkpoint "HOST_DISCOVERY_VALIDATE_PID pid=${desc} END result=MATCH"
      log_checkpoint "HOST_DISCOVERY_ATTEMPT_END result=FOUND pid=${desc}"
      echo "${desc}"
      return 0
    fi
    log_checkpoint "HOST_DISCOVERY_VALIDATE_PID pid=${desc} END result=NO_MATCH"
  done

  # Step 5: Fallback scan (all processes owned by user rocket)
  log_checkpoint "HOST_DISCOVERY_FALLBACK_SCAN_START"
  local fallback_pids=()
  local ps_pids
  ps_pids="$(timeout 1s ps -u rocket -o pid= 2>/dev/null || true)"
  for fp in ${ps_pids}; do
    [[ "${fp}" =~ ^[0-9]+$ ]] || continue
    [[ "${fp}" == "${cage_pid}" ]] && continue
    local already_tested=false
    for tested in "${dedup_candidates[@]}" "${descendant_pids[@]}"; do
      if [[ "${fp}" == "${tested}" ]]; then
        already_tested=true
        break
      fi
    done
    [[ "${already_tested}" == "true" ]] && continue
    fallback_pids+=("${fp}")
  done

  for fp in "${fallback_pids[@]}"; do
    log_checkpoint "HOST_DISCOVERY_VALIDATE_PID pid=${fp} START (fallback)"
    if is_shell_host_process "${fp}" "${cage_pid}" "false"; then
      log_checkpoint "HOST_DISCOVERY_VALIDATE_PID pid=${fp} END result=MATCH"
      log_checkpoint "HOST_DISCOVERY_FALLBACK_SCAN_END result=FOUND pid=${fp}"
      log_checkpoint "HOST_DISCOVERY_ATTEMPT_END result=FOUND pid=${fp}"
      echo "${fp}"
      return 0
    fi
    log_checkpoint "HOST_DISCOVERY_VALIDATE_PID pid=${fp} END result=NO_MATCH"
  done
  log_checkpoint "HOST_DISCOVERY_FALLBACK_SCAN_END result=NONE"
  log_checkpoint "HOST_DISCOVERY_ATTEMPT_END result=NONE"

  echo ""
  return 1
}

# Find all shell-host PIDs (to detect duplicates or orphan processes)
find_all_shell_host_pids() {
  local cage_pid="${1:-}"
  local pids=()
  # 1. Direct Cage children
  if [[ -n "${cage_pid}" && -d "/proc/${cage_pid}" ]]; then
    local children_raw=""
    if [[ -r "/proc/${cage_pid}/task/${cage_pid}/children" ]]; then
      children_raw="$(cat "/proc/${cage_pid}/task/${cage_pid}/children" 2>/dev/null || true)"
    fi
    for c in ${children_raw}; do
      if is_shell_host_process "${c}" "${cage_pid}" "false"; then
        pids+=("${c}")
      fi
    done
  fi
  # 2. Bounded rocket processes via ps
  local rocket_pids
  rocket_pids="$(timeout 1s ps -u rocket -o pid= 2>/dev/null || true)"
  for p in ${rocket_pids}; do
    [[ "${p}" =~ ^[0-9]+$ ]] || continue
    local already=false
    for ep in "${pids[@]}"; do
      if [[ "${ep}" == "${p}" ]]; then
        already=true
        break
      fi
    done
    if [[ "${already}" != "true" ]] && is_shell_host_process "${p}" "${cage_pid}" "true"; then
      pids+=("${p}")
    fi
  done
  echo "${pids[*]:-}"
}

# Enumerate candidate processes directly via /proc (hardened diagnostics)
enumerate_candidate_processes() {
  local cage_pid="${1:-}"
  local out=""
  local pids_to_inspect=()

  # 1. Cage direct children
  if [[ -n "${cage_pid}" && -d "/proc/${cage_pid}" ]]; then
    local c_raw=""
    if [[ -r "/proc/${cage_pid}/task/${cage_pid}/children" ]]; then
      c_raw="$(cat "/proc/${cage_pid}/task/${cage_pid}/children" 2>/dev/null || true)"
    fi
    if [[ -z "${c_raw// /}" ]]; then
      c_raw="$(timeout 1s pgrep -P "${cage_pid}" 2>/dev/null | tr '\n' ' ' || true)"
    fi
    for c in ${c_raw}; do
      [[ "${c}" =~ ^[0-9]+$ ]] && pids_to_inspect+=("${c}")
    done
  fi

  # 2. Descendants of those children
  for c in "${pids_to_inspect[@]}"; do
    if [[ -d "/proc/${c}" && -r "/proc/${c}/task/${c}/children" ]]; then
      local sc_raw
      sc_raw="$(cat "/proc/${c}/task/${c}/children" 2>/dev/null || true)"
      for sc in ${sc_raw}; do
        [[ "${sc}" =~ ^[0-9]+$ ]] && pids_to_inspect+=("${sc}")
      done
    fi
  done

  # 3. Add processes owned by rocket
  local rocket_pids
  rocket_pids="$(timeout 1s ps -u rocket -o pid= 2>/dev/null || true)"
  for rp in ${rocket_pids}; do
    [[ "${rp}" =~ ^[0-9]+$ ]] || continue
    local exists=false
    for ep in "${pids_to_inspect[@]}"; do
      if [[ "${ep}" == "${rp}" ]]; then
        exists=true
        break
      fi
    done
    [[ "${exists}" != "true" ]] && pids_to_inspect+=("${rp}")
  done

  for pid in "${pids_to_inspect[@]}"; do
    [[ -d "/proc/${pid}" ]] || continue
    local ppid=""
    local uid=""
    if [[ -r "/proc/${pid}/status" ]]; then
      while IFS=: read -r key val; do
        if [[ "${key}" == "PPid" ]]; then
          read -r ppid _ <<< "${val}"
        elif [[ "${key}" == "Uid" ]]; then
          read -r uid _ <<< "${val}"
        fi
      done < "/proc/${pid}/status" 2>/dev/null || true
    fi
    local comm="(unknown)"
    if [[ -r "/proc/${pid}/comm" ]]; then
      read -r comm < "/proc/${pid}/comm" 2>/dev/null || comm="(unknown)"
    fi
    local cmdline="(unreadable)"
    if [[ -r "/proc/${pid}/cmdline" ]]; then
      cmdline="$(timeout 1s tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null || echo '(unreadable)')"
    fi
    out+="PID=${pid}"$'\n'
    out+="PPID=${ppid}"$'\n'
    out+="UID=${uid}"$'\n'
    out+="COMM=${comm}"$'\n'
    out+="CMDLINE=${cmdline}"$'\n'
  done
  echo "${out:- (no candidate processes found)}"
}

# Hardened Diagnostic Evidence Collector (Guaranteed to return 0 and never throw error)
collect_graphical_debug_evidence() {
  local target_pid="${1:-${HOST_PID:-unknown}}"
  local cage_pid
  cage_pid="$(get_authoritative_cage_pid 2>/dev/null || echo '')"
  local cage_cmdline="(cage cmdline unavailable)"
  local cage_children="(none)"
  if [[ -n "${cage_pid}" && -d "/proc/${cage_pid}" ]]; then
    cage_cmdline="$(timeout 1s tr '\0' ' ' < "/proc/${cage_pid}/cmdline" 2>/dev/null || echo '(read failed)')"
    if [[ -r "/proc/${cage_pid}/task/${cage_pid}/children" ]]; then
      cage_children="$(cat "/proc/${cage_pid}/task/${cage_pid}/children" 2>/dev/null || true)"
    fi
    if [[ -z "${cage_children// /}" ]]; then
      cage_children="$(timeout 1s pgrep -P "${cage_pid}" 2>/dev/null | tr '\n' ' ' || echo 'none')"
    fi
  fi

  local host_cmdline="(host cmdline unavailable)"
  local host_ppid="(unavailable)"
  if [[ -n "${target_pid}" && "${target_pid}" != "none" && "${target_pid}" != "unknown" && -d "/proc/${target_pid}" ]]; then
    host_cmdline="$(timeout 1s tr '\0' ' ' < "/proc/${target_pid}/cmdline" 2>/dev/null || echo '(read failed)')"
    host_ppid="$(timeout 1s ps -p "${target_pid}" -o ppid= 2>/dev/null | tr -d '[:space:]' || echo 'unknown')"
  fi

  local current_hosts
  current_hosts="$(find_all_shell_host_pids "${cage_pid}" 2>/dev/null || echo 'none')"
  [[ -z "${current_hosts}" ]] && current_hosts="none"

  local all_cage_pids
  all_cage_pids="$(timeout 1s pgrep -u rocket -x cage 2>/dev/null | tr '\n' ' ' || echo 'none')"

  local candidate_processes
  candidate_processes="$(enumerate_candidate_processes "${cage_pid}" 2>/dev/null || echo '(enumeration failed)')"

  local probe_status
  probe_status="$(timeout 2s systemctl status rocketos-boot-probe.service --no-pager 2>/dev/null || echo '(probe status unavailable)')"
  local probe_journal
  probe_journal="$(timeout 2s journalctl -u rocketos-boot-probe.service -n 30 --no-pager 2>/dev/null || echo '(probe journal unavailable)')"

  local session_state
  session_state="$(timeout 2s systemctl is-active rocketos-graphical-session.service 2>/dev/null || echo 'unknown')"
  local session_status
  session_status="$(timeout 2s systemctl status rocketos-graphical-session.service --no-pager 2>/dev/null || echo '(session status unavailable)')"
  local session_journal
  session_journal="$(timeout 2s journalctl -u rocketos-graphical-session.service -n 50 --no-pager 2>/dev/null || echo '(session journal unavailable)')"

  local run_user_listing
  run_user_listing="$(timeout 2s ls -la "/run/user/${ROCKET_UID}" 2>/dev/null || echo "(listing failed for /run/user/${ROCKET_UID})")"

  local pstree_out="(pstree unavailable)"
  if command -v pstree >/dev/null 2>&1; then
    if [[ -n "${cage_pid}" && -d "/proc/${cage_pid}" ]]; then
      pstree_out="$(timeout 2s pstree -ap "${cage_pid}" 2>/dev/null || echo '(pstree failed)')"
    else
      pstree_out="$(timeout 2s pstree -ap 2>/dev/null || echo '(pstree failed)')"
    fi
  fi

  local ps_rocket_out
  ps_rocket_out="$(timeout 2s ps -u rocket -o pid,ppid,user,stat,comm,args 2>/dev/null || echo '(ps -u rocket failed)')"
  local ps_ef_snippet
  ps_ef_snippet="$(timeout 2s ps -ef 2>/dev/null || echo '(ps -ef failed)')"

  local ui_val="(file not present)"
  [ -f "${UI_LOADED_MARKER}" ] && ui_val="$(cat "${UI_LOADED_MARKER}" 2>/dev/null || echo '(read failed)')"
  local ping_val="(file not present)"
  [ -f "${BRIDGE_PING_MARKER}" ] && ping_val="$(cat "${BRIDGE_PING_MARKER}" 2>/dev/null || echo '(read failed)')"

  local webkit_err="(no webkit error recorded)"
  local webkit_err_file="/run/user/${ROCKET_UID}/rocketos-webkit-error"
  [ -f "${webkit_err_file}" ] && webkit_err="$(cat "${webkit_err_file}" 2>/dev/null || echo '(read failed)')"

  local host_state="(file not present)"
  [ -f "${STATE_FILE}" ] && host_state="$(cat "${STATE_FILE}" 2>/dev/null || echo '(read failed)')"

  local alive_val="(file not present)"
  [ -f "${ALIVE_MARKER}" ] && alive_val="$(cat "${ALIVE_MARKER}" 2>/dev/null || echo '(read failed)')"

  local host_log="(file not present)"
  if [ -f "${HOST_LOG_FILE}" ]; then
    host_log="$(tail -n 100 "${HOST_LOG_FILE}" 2>/dev/null || echo '(read failed)')"
  fi

  # Expected generation specific evidence
  local exp_state="(generation state file not present)"
  local exp_state_file="${STATE_FILE}.${target_pid}"
  [ -f "${exp_state_file}" ] && exp_state="$(cat "${exp_state_file}" 2>/dev/null || echo '(read failed)')"

  local exp_log="(generation log file not present)"
  local exp_log_file="${HOST_LOG_FILE}.${target_pid}"
  [ -f "${exp_log_file}" ] && exp_log="$(tail -n 100 "${exp_log_file}" 2>/dev/null || echo '(read failed)')"

  local exp_err="(generation error file not present)"
  local exp_err_file="${WEBKIT_ERROR_FILE}.${target_pid}"
  [ -f "${exp_err_file}" ] && exp_err="$(cat "${exp_err_file}" 2>/dev/null || echo '(read failed)')"

  local exp_alive="no"
  if [[ -n "${target_pid}" && "${target_pid}" =~ ^[0-9]+$ ]] && kill -0 "${target_pid}" 2>/dev/null; then
    exp_alive="yes"
  fi

  # Cage session exit status and signal parsing
  local cage_exit_status=""
  cage_exit_status="$(systemctl show --property=ExecMainStatus --value rocketos-graphical-session.service 2>/dev/null || true)"
  if [[ -z "${cage_exit_status}" || "${cage_exit_status}" == "0" ]]; then
    cage_exit_status="$(journalctl -u rocketos-graphical-session.service -n 30 --no-pager 2>/dev/null | grep -o 'status=[0-9]\+' | tail -n1 | cut -d= -f2 || true)"
  fi
  local child_sig_num="N/A"
  local child_sig_name="N/A"
  if [[ "${cage_exit_status}" =~ ^[0-9]+$ && ${cage_exit_status} -gt 128 && ${cage_exit_status} -le 192 ]]; then
    child_sig_num=$((cage_exit_status - 128))
    if [[ ${child_sig_num} -eq 5 ]]; then
      child_sig_name="SIGTRAP"
    elif [[ ${child_sig_num} -eq 9 ]]; then
      child_sig_name="SIGKILL"
    elif [[ ${child_sig_num} -eq 11 ]]; then
      child_sig_name="SIGSEGV"
    elif [[ ${child_sig_num} -eq 6 ]]; then
      child_sig_name="SIGABRT"
    elif [[ ${child_sig_num} -eq 15 ]]; then
      child_sig_name="SIGTERM"
    else
      child_sig_name="SIGNAL_${child_sig_num}"
    fi
  fi

  local last_host_state_parsed="unknown"
  if [[ -f "${exp_state_file}" ]]; then
    last_host_state_parsed="$(grep '^STATE=' "${exp_state_file}" 2>/dev/null | cut -d= -f2- || echo 'unknown')"
  fi

  # Rendering profile variables
  local ren_wlr="${WLR_RENDERER:-pixman}"
  local ren_libgl="${LIBGL_ALWAYS_SOFTWARE:-1}"
  local ren_skia="${WEBKIT_SKIA_ENABLE_CPU_RENDERING:-1}"
  local ren_shm="${WEBKIT_DMABUF_RENDERER_FORCE_SHM:-1}"
  local ren_dis_comp="${WEBKIT_DISABLE_COMPOSITING_MODE:-unset}"
  local ren_dis_dmabuf="${WEBKIT_DISABLE_DMABUF_RENDERER:-unset}"
  local ren_gdk="${GDK_BACKEND:-wayland}"

  local bwrap_cmd
  bwrap_cmd="$(command -v bwrap 2>/dev/null || echo 'not found')"
  local bwrap_ver="(unavailable)"
  if [[ "${bwrap_cmd}" != "not found" ]]; then
    bwrap_ver="$(timeout 2s bwrap --version 2>/dev/null || echo '(bwrap --version failed)')"
  fi
  local userns_clone
  userns_clone="$(timeout 2s sysctl -n kernel.unprivileged_userns_clone 2>/dev/null || timeout 2s sysctl kernel.unprivileged_userns_clone 2>/dev/null || echo 'N/A')"
  local max_userns="(unreadable)"
  if [ -f /proc/sys/user/max_user_namespaces ]; then
    max_userns="$(cat /proc/sys/user/max_user_namespaces 2>/dev/null || echo '(unreadable)')"
  fi
  local diag_dir_ls
  diag_dir_ls="$(timeout 2s ls -l /usr/share/rocketos/diagnostic 2>/dev/null || echo '(ls failed)')"
  local diag_stat
  diag_stat="$(timeout 2s stat /usr/share/rocketos/diagnostic/index.html 2>/dev/null || echo '(stat failed)')"

  # Sandbox and capability diagnostic state
  local preflight_err_content="<absent>"
  if [[ -f "${SANDBOX_PREFLIGHT_ERROR}" ]]; then
    preflight_err_content="$(cat "${SANDBOX_PREFLIGHT_ERROR}" 2>/dev/null || echo '(read failed)')"
  fi

  local svc_cap_bnd
  svc_cap_bnd="$(timeout 2s systemctl show rocketos-graphical-session.service --property=CapabilityBoundingSet --value 2>/dev/null || echo '(unavailable)')"
  local svc_cap_amb
  svc_cap_amb="$(timeout 2s systemctl show rocketos-graphical-session.service --property=AmbientCapabilities --value 2>/dev/null || echo '(unavailable)')"

  local sess_pid
  sess_pid="$(timeout 1s pgrep -u rocket -f rocketos-session 2>/dev/null | head -n1 || echo '')"
  local sess_cap_inh="(unavailable)"
  local sess_cap_prm="(unavailable)"
  local sess_cap_eff="(unavailable)"
  local sess_cap_bnd="(unavailable)"
  local sess_cap_amb="(unavailable)"
  local sess_no_new_privs="(unavailable)"

  if [[ -n "${sess_pid}" && -r "/proc/${sess_pid}/status" ]]; then
    while IFS=: read -r key val; do
      val="$(echo "${val}" | tr -d '[:space:]')"
      case "${key}" in
        CapInh) sess_cap_inh="${val}" ;;
        CapPrm) sess_cap_prm="${val}" ;;
        CapEff) sess_cap_eff="${val}" ;;
        CapBnd) sess_cap_bnd="${val}" ;;
        CapAmb) sess_cap_amb="${val}" ;;
        NoNewPrivs) sess_no_new_privs="${val}" ;;
      esac
    done < "/proc/${sess_pid}/status" 2>/dev/null || true
  else
    local j_inh
    j_inh="$(journalctl -u rocketos-graphical-session.service -n 50 --no-pager 2>/dev/null | grep -o 'CapInh=[0-9a-fA-F]\+' | tail -n1 | cut -d= -f2 || true)"
    if [[ -n "${j_inh}" ]]; then
      sess_cap_inh="${j_inh}"
      sess_cap_prm="$(journalctl -u rocketos-graphical-session.service -n 50 --no-pager 2>/dev/null | grep -o 'CapPrm=[0-9a-fA-F]\+' | tail -n1 | cut -d= -f2 || echo 'unknown')"
      sess_cap_eff="$(journalctl -u rocketos-graphical-session.service -n 50 --no-pager 2>/dev/null | grep -o 'CapEff=[0-9a-fA-F]\+' | tail -n1 | cut -d= -f2 || echo 'unknown')"
      sess_cap_bnd="$(journalctl -u rocketos-graphical-session.service -n 50 --no-pager 2>/dev/null | grep -o 'CapBnd=[0-9a-fA-F]\+' | tail -n1 | cut -d= -f2 || echo 'unknown')"
      sess_cap_amb="$(journalctl -u rocketos-graphical-session.service -n 50 --no-pager 2>/dev/null | grep -o 'CapAmb=[0-9a-fA-F]\+' | tail -n1 | cut -d= -f2 || echo 'unknown')"
      sess_no_new_privs="$(journalctl -u rocketos-graphical-session.service -n 50 --no-pager 2>/dev/null | grep -o 'NoNewPrivs=[0-9]\+' | tail -n1 | cut -d= -f2 || echo 'unknown')"
    fi
  fi

  local em_tty2_state="$(timeout 2s systemctl is-active getty@tty2.service 2>/dev/null || echo 'unknown')"
  local em_tty3_state="$(timeout 2s systemctl is-active getty@tty3.service 2>/dev/null || echo 'unknown')"
  local em_tty2_exec="$(timeout 2s systemctl show getty@tty2.service --property=ExecStart --value 2>/dev/null || echo 'unknown')"
  local em_tty3_exec="$(timeout 2s systemctl show getty@tty3.service --property=ExecStart --value 2>/dev/null || echo 'unknown')"
  local em_cmdline="$(cat /proc/cmdline 2>/dev/null || echo '(unreadable)')"

  cat <<EOF
--- GRAPHICAL RUNTIME DIAGNOSTIC EVIDENCE ---
CAGE_PID=${cage_pid}
CAGE_CMDLINE=${cage_cmdline}
CAGE_CHILDREN=${cage_children}

DIRECT AND DESCENDANT CANDIDATE PROCESS EVIDENCE:
${candidate_processes}
Expected Host PID:        ${target_pid}
Host Parent PID:          ${host_ppid}
Host Cmdline:             ${host_cmdline}
Current Host PID(s):      ${current_hosts}
All Cage PID(s):          ${all_cage_pids}
Graphical Service State:  ${session_state}
UI Marker Value:          '${ui_val}'
Bridge Ping Marker Value: '${ping_val}'

EXPECTED HOST GENERATION:
PID:                      ${target_pid}
Process still alive:      ${exp_alive}
State:
${exp_state}
Generation WebKit/error evidence:
${exp_err}
Last 100 generation log lines:
${exp_log}

CAGE SESSION EXIT DIAGNOSTICS:
CAGE_EXIT_STATUS=${cage_exit_status:-unknown}
CHILD_SIGNAL_NUMBER=${child_sig_num}
CHILD_SIGNAL_NAME=${child_sig_name}
EXPECTED_HOST_PID=${target_pid}
LAST_HOST_STATE=${last_host_state_parsed}

CURRENT HOST GENERATION:
Current state file:
${host_state}
Current alive marker:     '${alive_val}'
Current shell host PID(s): ${current_hosts}
Shared Host Log (last 100 lines):
${host_log}
Shared WebKit Load Error File:
${webkit_err}

CAGE / WEBKIT RUNTIME:
Cage version:             $(/usr/bin/cage -v 2>&1 || echo '(cage -v unavailable)')
GTK version:              $(grep 'GTK=' "${exp_state_file}" 2>/dev/null | cut -d= -f2- || grep -o 'GTK [0-9.]\+' "${exp_log_file}" 2>/dev/null | head -n1 || echo '(unknown)')
WebKitGTK version:        $(grep 'WebKitGTK=' "${exp_state_file}" 2>/dev/null | cut -d= -f2- || grep -o 'WebKitGTK [0-9.]\+' "${exp_log_file}" 2>/dev/null | head -n1 || echo '(unknown)')

RENDERING PROFILE:
WLR_RENDERER=${ren_wlr}
LIBGL_ALWAYS_SOFTWARE=${ren_libgl}
WEBKIT_SKIA_ENABLE_CPU_RENDERING=${ren_skia}
WEBKIT_DMABUF_RENDERER_FORCE_SHM=${ren_shm}
WEBKIT_DISABLE_COMPOSITING_MODE=${ren_dis_comp}
WEBKIT_DISABLE_DMABUF_RENDERER=${ren_dis_dmabuf}
GDK_BACKEND=${ren_gdk}

SANDBOX / CAPABILITY STATE:
rocketos-sandbox-preflight-error:
${preflight_err_content}

Graphical service capability policy:
CapabilityBoundingSet: ${svc_cap_bnd}
AmbientCapabilities: ${svc_cap_amb}

Current rocketos-session capability fields:
CapInh: ${sess_cap_inh}
CapPrm: ${sess_cap_prm}
CapEff: ${sess_cap_eff}
CapBnd: ${sess_cap_bnd}
CapAmb: ${sess_cap_amb}
NoNewPrivs: ${sess_no_new_privs}

bubblewrap path: ${bwrap_cmd}
bubblewrap version: ${bwrap_ver}

Recent bwrap-related journal:
${bwrap_recent_journal}

ENVIRONMENT & SANDBOX PREREQUISITES:
command -v bwrap:
${bwrap_cmd}
bwrap --version:
${bwrap_ver}
sysctl kernel.unprivileged_userns_clone:
${userns_clone}
cat /proc/sys/user/max_user_namespaces:
${max_userns}
ls -l /usr/share/rocketos/diagnostic:
${diag_dir_ls}
stat /usr/share/rocketos/diagnostic/index.html:
${diag_stat}
Contents of /run/user/${ROCKET_UID}:
${run_user_listing}
PSTREE:
${pstree_out}
Processes Owned by rocket:
${ps_rocket_out}
All Processes (ps -ef):
${ps_ef_snippet}
Boot Probe Service Status:
${probe_status}
Boot Probe Journal:
${probe_journal}
Session Service Status:
${session_status}
Recent Session Journal:
${session_journal}
Emergency TTY2 State:     ${em_tty2_state}
Emergency TTY3 State:     ${em_tty3_state}
Emergency TTY2 ExecStart: ${em_tty2_exec}
Emergency TTY3 ExecStart: ${em_tty3_exec}
Kernel Cmdline:           ${em_cmdline}
---------------------------------------------
EOF
}

# Resolve exact failure code from shell-host lifecycle state and error markers
resolve_readiness_failure_code() {
  local expected_pid="$1"

  local gen_state_file="${STATE_FILE}.${expected_pid}"
  local gen_error_file="${WEBKIT_ERROR_FILE}.${expected_pid}"
  local host_state=""
  local state_pid=""

  # Authoritatively read generation-specific state first
  if [[ -f "${gen_state_file}" ]]; then
    host_state="$(grep '^STATE=' "${gen_state_file}" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]' || true)"
    state_pid="$(grep '^PID=' "${gen_state_file}" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]' || true)"
  elif [[ -f "${STATE_FILE}" ]]; then
    host_state="$(grep '^STATE=' "${STATE_FILE}" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]' || true)"
    state_pid="$(grep '^PID=' "${STATE_FILE}" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]' || true)"
  fi

  local alive_pid=""
  if [[ -f "${ALIVE_MARKER}" ]]; then
    alive_pid="$(head -n1 "${ALIVE_MARKER}" 2>/dev/null | tr -d '[:space:]' || true)"
  fi

  # 1. Missing diagnostic asset failure
  if [[ "${host_state}" == "DIAGNOSTIC_ASSET_MISSING" ]]; then
    echo "diagnostic_asset_missing"
    return 0
  fi
  if [[ -f "${gen_error_file}" ]] && grep -q "DIAGNOSTIC_ASSET_MISSING" "${gen_error_file}" 2>/dev/null; then
    echo "diagnostic_asset_missing"
    return 0
  fi

  # 2. Host fatal exception during initialization / activate (strictly scoped to generation)
  if [[ "${host_state}" == "HOST_FATAL_EXCEPTION" ]]; then
    echo "shell_host_exception"
    return 0
  fi
  if [[ -f "${gen_error_file}" ]] && grep -q "HOST_FATAL_EXCEPTION" "${gen_error_file}" 2>/dev/null; then
    echo "shell_host_exception"
    return 0
  fi

  # 3. Sandbox preflight error and bwrap capability leak checks (strictly outranks native signal 133)
  if [[ -f "${SANDBOX_PREFLIGHT_ERROR}" ]]; then
    local preflight_type
    preflight_type="$(grep '^TYPE=' "${SANDBOX_PREFLIGHT_ERROR}" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]' || true)"
    if [[ "${preflight_type}" == "CAPABILITY_LEAK" ]]; then
      echo "webkit_sandbox_capability_leak"
      return 0
    elif [[ "${preflight_type}" == "BWRAP_MISSING" ]]; then
      echo "webkit_sandbox_bwrap_missing"
      return 0
    elif [[ "${preflight_type}" == "BWRAP_FUNCTIONAL_FAILURE" ]]; then
      echo "webkit_sandbox_preflight_failure"
      return 0
    fi
  fi

  # Exact bwrap capability error in session journal
  if journalctl -u rocketos-graphical-session.service -n 100 --no-pager 2>/dev/null | grep -q "Unexpected capabilities but not setuid"; then
    echo "webkit_sandbox_capability_leak"
    return 0
  fi

  # 4. WebKit web process terminated (strictly scoped to generation)
  if [[ "${host_state}" == "WEBKIT_PROCESS_TERMINATED" ]]; then
    echo "webkit_process_terminated"
    return 0
  fi
  if [[ -f "${gen_error_file}" ]] && grep -q "WEB_PROCESS_TERMINATED" "${gen_error_file}" 2>/dev/null; then
    echo "webkit_process_terminated"
    return 0
  fi

  # 4. WebKit load failed (strictly scoped to generation)
  if [[ "${host_state}" == "WEBKIT_LOAD_FAILED" ]]; then
    echo "webkit_load_failed"
    return 0
  fi
  if [[ -f "${gen_error_file}" ]] && grep -q "URI:" "${gen_error_file}" 2>/dev/null; then
    echo "webkit_load_failed"
    return 0
  fi

  # 5. Cage exit status signal check: Cage returns 128 + WTERMSIG(status)
  # When status=133 -> 128 + 5 = SIGTRAP
  local cage_exit_status=""
  cage_exit_status="$(systemctl show --property=ExecMainStatus --value rocketos-graphical-session.service 2>/dev/null || true)"
  if [[ -z "${cage_exit_status}" || "${cage_exit_status}" == "0" ]]; then
    cage_exit_status="$(journalctl -u rocketos-graphical-session.service -n 30 --no-pager 2>/dev/null | grep -o 'status=[0-9]\+' | tail -n1 | cut -d= -f2 || true)"
  fi

  if [[ "${cage_exit_status}" == "133" ]]; then
    echo "shell_host_native_sigtrap"
    return 0
  elif [[ "${cage_exit_status}" =~ ^[0-9]+$ && ${cage_exit_status} -gt 128 && ${cage_exit_status} -le 192 ]]; then
    echo "shell_host_native_signal"
    return 0
  fi

  # 5. WebView is never successfully created
  if [[ "${host_state}" == "GTK_ACTIVATE_ENTER" || "${host_state}" == "WEB_CONTEXT_READY" || "${host_state}" == "CONTENT_MANAGER_CREATED" || "${host_state}" == "BRIDGE_HANDLER_REGISTERED" || "${host_state}" == "SETTINGS_CREATED" || "${host_state}" == "WEBVIEW_CONSTRUCTION_ENTER" ]]; then
    echo "webview_creation_failure"
    return 0
  fi

  # 6. Host never reaches GTK activation
  if [[ -z "${host_state}" || "${host_state}" == "PROCESS_STARTED" || "${host_state}" == "GI_IMPORT_OK" || "${host_state}" == "APPLICATION_CREATED" || "${host_state}" == "APPLICATION_RUN_ENTER" ]]; then
    echo "shell_host_startup_failure"
    return 0
  fi

  # 7. FINISHED happened but marker is absent or has wrong PID
  if [[ "${host_state}" == "WEBKIT_LOAD_FINISHED" ]]; then
    local ui_pid=""
    if [[ -f "${UI_LOADED_MARKER}" ]]; then
      ui_pid="$(head -n1 "${UI_LOADED_MARKER}" 2>/dev/null | tr -d '[:space:]' || true)"
    fi
    if [[ "${ui_pid}" != "${expected_pid}" ]]; then
      echo "ui_marker_creation_failure"
      return 0
    fi
  fi

  # 8. Host state PID or alive marker PID mismatch ONLY if both processes are concurrently alive/conflicting
  if [[ -n "${state_pid}" && "${state_pid}" != "${expected_pid}" ]]; then
    if kill -0 "${state_pid}" 2>/dev/null && kill -0 "${expected_pid}" 2>/dev/null; then
      echo "shell_host_pid_mismatch"
      return 0
    fi
  fi
  if [[ -n "${alive_pid}" && "${alive_pid}" != "${expected_pid}" ]]; then
    if kill -0 "${alive_pid}" 2>/dev/null && kill -0 "${expected_pid}" 2>/dev/null; then
      echo "shell_host_pid_mismatch"
      return 0
    fi
  fi

  # 9. Load requested/started/committed but WebKit never finished
  if [[ "${host_state}" == "LOAD_URI_REQUESTED" || "${host_state}" == "WEBVIEW_CREATED" || "${host_state}" == "WINDOW_CHILD_SET" || "${host_state}" == "GTK_WINDOW_PRESENTED" || "${host_state}" == "WEBKIT_LOAD_STARTED" || "${host_state}" == "WEBKIT_LOAD_REDIRECTED" || "${host_state}" == "WEBKIT_LOAD_COMMITTED" ]]; then
    echo "ui_marker_timeout"
    return 0
  fi

  # 10. Bridge marker timeout if UI loaded but ping marker absent
  if [[ "${host_state}" == "UI_MARKER_CREATED" || "${host_state}" == "WEBKIT_LOAD_FINISHED" ]]; then
    local ping_pid=""
    if [[ -f "${BRIDGE_PING_MARKER}" ]]; then
      ping_pid="$(head -n1 "${BRIDGE_PING_MARKER}" 2>/dev/null | tr -d '[:space:]' || true)"
    fi
    if [[ "${ping_pid}" != "${expected_pid}" ]]; then
      echo "bridge_marker_timeout"
      return 0
    fi
  fi

  echo "ui_marker_timeout"
}

# ------------------------------------------------------------------------------
# Phase 3 Probe Execution
# ------------------------------------------------------------------------------
log_checkpoint "PHASE3_PROBE_START"

# 1. Verify kernel is running and responsive
if [ ! -f /proc/version ]; then
  emit_fail "/proc/version not found; kernel virtual filesystem is not accessible"
fi

KERNEL_UNAME="$(uname -srmo 2>/dev/null || true)"
if [[ -z "${KERNEL_UNAME}" ]]; then
  emit_fail "uname command failed to report kernel information"
fi

KERNEL_RELEASE="$(uname -r 2>/dev/null || true)"
log_checkpoint "PHASE3_KERNEL_CHECK_OK uname='${KERNEL_UNAME}'"

# 2. Verify architecture is x86_64
ARCH="$(uname -m 2>/dev/null || true)"
if [[ "${ARCH}" != "x86_64" ]]; then
  emit_fail "Architecture is '${ARCH}', expected 'x86_64'"
fi
log_checkpoint "PHASE3_ARCH_CHECK_OK arch='${ARCH}'"

# 3. Verify PID 1 / init system is systemd
INIT_NAME=""
if [ -r /proc/1/comm ]; then
  INIT_NAME="$(cat /proc/1/comm 2>/dev/null || true)"
fi
if [[ -z "${INIT_NAME}" ]]; then
  INIT_NAME="$(ps -p 1 -o comm= 2>/dev/null || true)"
fi
if [[ "${INIT_NAME}" != "systemd" ]]; then
  emit_fail "PID 1 is '${INIT_NAME}', expected 'systemd'"
fi
log_checkpoint "PHASE3_INIT_SYSTEMD_OK"

# 4. Verify systemd health state (multi-user.target reached and active)
for _ in {1..30}; do
  if systemctl is-active --quiet multi-user.target 2>/dev/null; then
    break
  fi
  sleep 1
done

if ! systemctl is-active --quiet multi-user.target 2>/dev/null; then
  emit_fail "systemd multi-user.target is not active"
fi

# 5. Verify systemd startup settlement
SYSTEMD_STATE="$(systemctl is-system-running 2>/dev/null || true)"
for _ in {1..30}; do
  if [[ "${SYSTEMD_STATE}" == "running" || "${SYSTEMD_STATE}" == "degraded" ]]; then
    break
  fi
  sleep 1
  SYSTEMD_STATE="$(systemctl is-system-running 2>/dev/null || true)"
done

# 6. Verify /etc/os-release identity
if [ ! -f /etc/os-release ]; then
  emit_fail "/etc/os-release does not exist"
fi

OS_ID="$(grep '^ID=' /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '"' || true)"
if [[ "${OS_ID}" != "rocketos" ]]; then
  emit_fail "/etc/os-release ID is '${OS_ID}', expected 'rocketos'"
fi

OS_ID_LIKE="$(grep '^ID_LIKE=' /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '"' || true)"
if [[ ! "${OS_ID_LIKE}" =~ (^|[[:space:]])debian([[:space:]]|$) ]]; then
  emit_fail "/etc/os-release ID_LIKE is '${OS_ID_LIKE}', expected to contain 'debian'"
fi

PRETTY_NAME="$(grep '^PRETTY_NAME=' /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '"' || true)"
VERSION_ID="$(grep '^VERSION_ID=' /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '"' || true)"
SYSTEMD_VERSION="$(systemctl --version 2>/dev/null | head -n1 | awk '{print $2}' || true)"
log_checkpoint "PHASE3_OS_RELEASE_OK id='${OS_ID}' version='${VERSION_ID}'"

# EMIT PHASE 2 MARKER FOR REGRESSION VERIFICATION
log_checkpoint "PHASE3_EMIT_PHASE2_MARKER"
PHASE2_OUTPUT="==================================================
ROCKETOS_PHASE2_BOOT_OK
==================================================
SYSTEM_NAME: RocketOS
PRETTY_NAME: ${PRETTY_NAME}
ID: ${OS_ID}
ID_LIKE: ${OS_ID_LIKE}
VERSION_ID: ${VERSION_ID}
KERNEL_UNAME: ${KERNEL_UNAME}
KERNEL_RELEASE: ${KERNEL_RELEASE}
ARCHITECTURE: ${ARCH}
HOSTNAME: $(hostname)
SYSTEMD_STATE: ${SYSTEMD_STATE}
INIT_SYSTEM: systemd ${SYSTEMD_VERSION}
TIMESTAMP_UTC: $(date -u '+%Y-%m-%dT%H:%M:%SZ')
=================================================="

if [ -e /dev/ttyS0 ] && [ -w /dev/ttyS0 ]; then
  echo "${PHASE2_OUTPUT}" > /dev/ttyS0 2>/dev/null || true
fi
echo "${PHASE2_OUTPUT}" >> "${LOG_FILE}" 2>/dev/null || true
echo "${PHASE2_OUTPUT}" > "${TARGET_DEV}" 2>/dev/null || true

# 7. PHASE 3 GRAPHICAL VERIFICATION
# 7a. Verify configured default target is graphical.target
log_checkpoint "PHASE3_CHECK_DEFAULT_TARGET_START"
DEFAULT_TARGET="$(systemctl get-default 2>/dev/null || true)"
if [[ "${DEFAULT_TARGET}" != "graphical.target" ]]; then
  emit_fail "Configured default systemd target is '${DEFAULT_TARGET}', expected 'graphical.target'"
fi
log_checkpoint "PHASE3_CHECK_DEFAULT_TARGET_OK target='${DEFAULT_TARGET}'"

# 7b. Wait for and require rocketos-graphical-session.service to be active
log_checkpoint "PHASE3_WAIT_GRAPHICAL_SERVICE_START"
GRAPHICAL_ACTIVE=false
for ((sec=1; sec<=35; sec++)); do
  if systemctl is-active --quiet rocketos-graphical-session.service 2>/dev/null; then
    GRAPHICAL_ACTIVE=true
    break
  fi
  sleep 1
done

if [[ "${GRAPHICAL_ACTIVE}" != "true" ]]; then
  SESSION_STATE="$(systemctl is-active rocketos-graphical-session.service 2>/dev/null || echo "inactive")"
  SESSION_STATUS="$(systemctl status rocketos-graphical-session.service --no-pager 2>/dev/null || true)"
  SESSION_JOURNAL="$(journalctl -u rocketos-graphical-session.service -n 50 --no-pager 2>/dev/null || true)"
  emit_fail "rocketos-graphical-session.service failed to activate (service state: ${SESSION_STATE})
--- SERVICE STATUS ---
${SESSION_STATUS}
--- SERVICE JOURNAL ---
${SESSION_JOURNAL}"
fi
log_checkpoint "PHASE3_WAIT_GRAPHICAL_SERVICE_OK"

# Verify unprivileged user rocket
log_checkpoint "PHASE3_VERIFY_ROCKET_USER_START"
if ! id rocket >/dev/null 2>&1; then
  emit_fail "Dedicated unprivileged user 'rocket' does not exist"
fi
log_checkpoint "PHASE3_VERIFY_ROCKET_USER_OK"

# Initial Process Discovery (Bounded)
log_checkpoint "PHASE3_DISCOVER_CAGE_START"
CAGE_PID=""
CAGE_DISCOVERY_START_SEC=$(date +%s)
CAGE_DISCOVERY_TIMEOUT_SECS=30
CAGE_DISCOVERY_DEADLINE=$((CAGE_DISCOVERY_START_SEC + CAGE_DISCOVERY_TIMEOUT_SECS))

while true; do
  CAGE_PID="$(get_authoritative_cage_pid || true)"
  if [[ -n "${CAGE_PID}" ]]; then
    break
  fi
  NOW=$(date +%s)
  if [[ ${NOW} -ge ${CAGE_DISCOVERY_DEADLINE} ]]; then
    break
  fi
  sleep 1
done

if [[ -z "${CAGE_PID}" ]]; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "none")"
  emit_fail "cage compositor is not running under user rocket within ${CAGE_DISCOVERY_TIMEOUT_SECS}s
${DEBUG_EVIDENCE}" "cage_compositor_not_running"
fi
log_checkpoint "PHASE3_DISCOVER_CAGE_OK pid=${CAGE_PID}"

log_checkpoint "PHASE3_DISCOVER_HOST_START"
HOST_PID=""
HOST_DISCOVERY_START_SEC=$(date +%s)
HOST_DISCOVERY_TIMEOUT_SECS=45
HOST_DISCOVERY_DEADLINE=$((HOST_DISCOVERY_START_SEC + HOST_DISCOVERY_TIMEOUT_SECS))
HOST_DISCOVERY_ATTEMPT=0

while true; do
  NOW=$(date +%s)
  if [[ ${NOW} -ge ${HOST_DISCOVERY_DEADLINE} ]]; then
    break
  fi

  HOST_DISCOVERY_ATTEMPT=$((HOST_DISCOVERY_ATTEMPT + 1))
  HOST_PID="$(find_shell_host_pid "${CAGE_PID}" "${HOST_DISCOVERY_ATTEMPT}" || true)"
  HOST_PID="$(echo "${HOST_PID}" | grep -E '^[0-9]+$' | head -n1 || true)"
  if [[ -n "${HOST_PID}" ]]; then
    break
  fi

  # Check for early failure: graphical session launcher crash-looping before host starts
  local n_restarts
  n_restarts="$(timeout 2s systemctl show rocketos-graphical-session.service --property=NRestarts --value 2>/dev/null || echo 0)"
  local exec_status
  exec_status="$(timeout 2s systemctl show rocketos-graphical-session.service --property=ExecMainStatus --value 2>/dev/null || echo 0)"
  local exec_code
  exec_code="$(timeout 2s systemctl show rocketos-graphical-session.service --property=ExecMainCode --value 2>/dev/null || echo 'unknown')"
  local main_pid
  main_pid="$(timeout 2s systemctl show rocketos-graphical-session.service --property=MainPID --value 2>/dev/null || echo 0)"

  # Check if sandbox preflight error occurred (outranks generic launcher failure)
  if [[ -f "${SANDBOX_PREFLIGHT_ERROR}" ]] || journalctl -u rocketos-graphical-session.service -n 50 --no-pager 2>/dev/null | grep -q "Unexpected capabilities but not setuid"; then
    local sb_fail="webkit_sandbox_preflight_failure"
    if [[ -f "${SANDBOX_PREFLIGHT_ERROR}" ]]; then
      local pt
      pt="$(grep '^TYPE=' "${SANDBOX_PREFLIGHT_ERROR}" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]' || true)"
      if [[ "${pt}" == "CAPABILITY_LEAK" ]]; then
        sb_fail="webkit_sandbox_capability_leak"
      elif [[ "${pt}" == "BWRAP_MISSING" ]]; then
        sb_fail="webkit_sandbox_bwrap_missing"
      elif [[ "${pt}" == "BWRAP_FUNCTIONAL_FAILURE" ]]; then
        sb_fail="webkit_sandbox_preflight_failure"
      fi
    elif journalctl -u rocketos-graphical-session.service -n 50 --no-pager 2>/dev/null | grep -q "Unexpected capabilities but not setuid"; then
      sb_fail="webkit_sandbox_capability_leak"
    fi
    DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "none")"
    emit_fail "Graphical session sandbox preflight failure (${sb_fail}):
${DEBUG_EVIDENCE}" "${sb_fail}"
  fi

  # Check if any generation state files exist
  local gen_files
  gen_files="$(ls -1 "${STATE_FILE}".* 2>/dev/null | grep -E '\.[0-9]+$' || true)"

  if [[ -z "${gen_files}" && "${n_restarts}" =~ ^[0-9]+$ && ${n_restarts} -ge 3 && -n "${exec_status}" && "${exec_status}" != "0" ]]; then
    DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "none")"
    emit_fail "Graphical session failed during launch (NRestarts=${n_restarts}, ExecMainStatus=${exec_status}, ExecMainCode=${exec_code}, MainPID=${main_pid})
${DEBUG_EVIDENCE}" "graphical_session_launcher_failure"
  fi

  NOW_AFTER=$(date +%s)
  if [[ ${NOW_AFTER} -ge ${HOST_DISCOVERY_DEADLINE} ]]; then
    break
  fi
  sleep 1
done

if [[ -z "${HOST_PID}" ]]; then
  # Check if sandbox preflight error occurred
  if [[ -f "${SANDBOX_PREFLIGHT_ERROR}" ]] || journalctl -u rocketos-graphical-session.service -n 50 --no-pager 2>/dev/null | grep -q "Unexpected capabilities but not setuid"; then
    local sb_fail="webkit_sandbox_preflight_failure"
    if [[ -f "${SANDBOX_PREFLIGHT_ERROR}" ]]; then
      local pt
      pt="$(grep '^TYPE=' "${SANDBOX_PREFLIGHT_ERROR}" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]' || true)"
      if [[ "${pt}" == "CAPABILITY_LEAK" ]]; then
        sb_fail="webkit_sandbox_capability_leak"
      elif [[ "${pt}" == "BWRAP_MISSING" ]]; then
        sb_fail="webkit_sandbox_bwrap_missing"
      elif [[ "${pt}" == "BWRAP_FUNCTIONAL_FAILURE" ]]; then
        sb_fail="webkit_sandbox_preflight_failure"
      fi
    elif journalctl -u rocketos-graphical-session.service -n 50 --no-pager 2>/dev/null | grep -q "Unexpected capabilities but not setuid"; then
      sb_fail="webkit_sandbox_capability_leak"
    fi
    DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "none")"
    emit_fail "Graphical session sandbox preflight failure (${sb_fail}):
${DEBUG_EVIDENCE}" "${sb_fail}"
  fi

  # Check if any generation state files exist to resolve failure from the latest generation
  local newest_gen_pid=""
  local gen_files
  gen_files="$(ls -1 "${STATE_FILE}".* 2>/dev/null | grep -E '\.[0-9]+$' || true)"
  if [[ -n "${gen_files}" ]]; then
    local newest_file
    newest_file="$(ls -1t "${STATE_FILE}".* 2>/dev/null | grep -E '\.[0-9]+$' | head -n1 || true)"
    if [[ -n "${newest_file}" ]]; then
      newest_gen_pid="${newest_file##*.}"
    fi
  fi

  if [[ -n "${newest_gen_pid}" && "${newest_gen_pid}" =~ ^[0-9]+$ ]]; then
    log_checkpoint "HOST_DISCOVERY_FAILED_RESOLVING_NEWEST_GENERATION pid=${newest_gen_pid}"
    DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${newest_gen_pid}")"
    FAIL_CODE="$(resolve_readiness_failure_code "${newest_gen_pid}")"
    emit_fail "rocket-shell-host is not currently running; latest generation PID ${newest_gen_pid} resolved failure: ${FAIL_CODE}
${DEBUG_EVIDENCE}" "${FAIL_CODE}"
  fi

  # Check if launcher failure occurred
  local n_restarts
  n_restarts="$(timeout 2s systemctl show rocketos-graphical-session.service --property=NRestarts --value 2>/dev/null || echo 0)"
  local exec_status
  exec_status="$(timeout 2s systemctl show rocketos-graphical-session.service --property=ExecMainStatus --value 2>/dev/null || echo 0)"
  if [[ "${n_restarts}" =~ ^[0-9]+$ && ${n_restarts} -ge 1 && -n "${exec_status}" && "${exec_status}" != "0" ]]; then
    DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "none")"
    emit_fail "Graphical session launcher failure: cage failed to start rocket-shell-host (NRestarts=${n_restarts}, ExecMainStatus=${exec_status})
${DEBUG_EVIDENCE}" "graphical_session_launcher_failure"
  fi

  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "none")"
  emit_fail "rocket-shell-host was not discovered within ${HOST_DISCOVERY_TIMEOUT_SECS}s
${DEBUG_EVIDENCE}" "shell_host_not_running"
fi

if [[ "${CAGE_PID}" == "${HOST_PID}" ]]; then
  emit_fail "Internal probe failure: CAGE_PID (${CAGE_PID}) was identified as HOST_PID" "shell_host_discovery_error"
fi
log_checkpoint "PHASE3_DISCOVER_HOST_OK pid=${HOST_PID}"

# Strengthen PID validation: verify state and alive marker PIDs if present and concurrently active
if [ -f "${STATE_FILE}" ]; then
  STATE_PID="$(grep '^PID=' "${STATE_FILE}" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]' || true)"
  if [[ -n "${STATE_PID}" && "${STATE_PID}" != "${HOST_PID}" ]] && kill -0 "${STATE_PID}" 2>/dev/null && kill -0 "${HOST_PID}" 2>/dev/null; then
    DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID}")"
    emit_fail "Host state PID mismatch: discovered host PID is ${HOST_PID} but state file recorded active PID ${STATE_PID}
${DEBUG_EVIDENCE}" "shell_host_pid_mismatch"
  fi
fi

if [ -f "${ALIVE_MARKER}" ]; then
  ALIVE_PID="$(cat "${ALIVE_MARKER}" 2>/dev/null | tr -d '[:space:]' || true)"
  if [[ -n "${ALIVE_PID}" && "${ALIVE_PID}" != "${HOST_PID}" ]] && kill -0 "${ALIVE_PID}" 2>/dev/null && kill -0 "${HOST_PID}" 2>/dev/null; then
    DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID}")"
    emit_fail "Host alive marker PID mismatch: discovered host PID is ${HOST_PID} but alive marker recorded active PID ${ALIVE_PID}
${DEBUG_EVIDENCE}" "shell_host_pid_mismatch"
  fi
fi

# Verify Diagnostic WebKit UI loaded and Native Bridge ping answered
# Bounded timeout (60 seconds) safe for software-rendered WebKitGTK under QEMU TCG
log_checkpoint "PHASE3_WAIT_INITIAL_READINESS_START expected_host_pid=${HOST_PID}"
INITIAL_READINESS_TIMEOUT_SECS=60
UI_LOADED_PID=""
BRIDGE_PING_PID=""

for ((sec=1; sec<=INITIAL_READINESS_TIMEOUT_SECS; sec++)); do
  # Verify that the expected host process has not prematurely died or crash-looped
  if ! kill -0 "${HOST_PID}" 2>/dev/null; then
    CURRENT_HOSTS="$(find_all_shell_host_pids "${CAGE_PID}")"
    DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID}")"
    FAIL_CODE="$(resolve_readiness_failure_code "${HOST_PID}")"
    emit_fail "Initial rocket-shell-host (PID ${HOST_PID}) unexpectedly terminated before completing UI readiness (current host PIDs: ${CURRENT_HOSTS:-none}, failure code: ${FAIL_CODE})
${DEBUG_EVIDENCE}" "${FAIL_CODE}"
  fi

  # Check for PID mismatch during runtime (only when two live processes conflict)
  if [ -f "${STATE_FILE}" ]; then
    STATE_PID="$(grep '^PID=' "${STATE_FILE}" 2>/dev/null | cut -d= -f2- | tr -d '[:space:]' || true)"
    if [[ -n "${STATE_PID}" && "${STATE_PID}" != "${HOST_PID}" ]] && kill -0 "${STATE_PID}" 2>/dev/null && kill -0 "${HOST_PID}" 2>/dev/null; then
      DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID}")"
      emit_fail "Host state PID mismatch during readiness: expected ${HOST_PID} but state file recorded active PID ${STATE_PID}
${DEBUG_EVIDENCE}" "shell_host_pid_mismatch"
    fi
  fi
  if [ -f "${ALIVE_MARKER}" ]; then
    ALIVE_PID="$(cat "${ALIVE_MARKER}" 2>/dev/null | tr -d '[:space:]' || true)"
    if [[ -n "${ALIVE_PID}" && "${ALIVE_PID}" != "${HOST_PID}" ]] && kill -0 "${ALIVE_PID}" 2>/dev/null && kill -0 "${HOST_PID}" 2>/dev/null; then
      DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID}")"
      emit_fail "Host alive marker PID mismatch during readiness: expected ${HOST_PID} but alive marker recorded active PID ${ALIVE_PID}
${DEBUG_EVIDENCE}" "shell_host_pid_mismatch"
    fi
  fi

  if [ -f "${UI_LOADED_MARKER}" ] && [ -f "${BRIDGE_PING_MARKER}" ]; then
    UI_LOADED_PID="$(head -n1 "${UI_LOADED_MARKER}" 2>/dev/null | tr -d '[:space:]' || true)"
    BRIDGE_PING_PID="$(head -n1 "${BRIDGE_PING_MARKER}" 2>/dev/null | tr -d '[:space:]' || true)"
    if [[ "${UI_LOADED_PID}" == "${HOST_PID}" && "${BRIDGE_PING_PID}" == "${HOST_PID}" ]]; then
      break
    fi
  fi
  sleep 1
done

if [[ "${UI_LOADED_PID}" != "${HOST_PID}" || "${BRIDGE_PING_PID}" != "${HOST_PID}" ]]; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID}")"
  FAIL_CODE="$(resolve_readiness_failure_code "${HOST_PID}")"
  if [[ "${UI_LOADED_PID}" != "${HOST_PID}" ]]; then
    emit_fail "Diagnostic UI failed to complete loading within ${INITIAL_READINESS_TIMEOUT_SECS}s (expected host PID ${HOST_PID}, marker recorded '${UI_LOADED_PID}', resolved failure: ${FAIL_CODE})
${DEBUG_EVIDENCE}" "${FAIL_CODE}"
  else
    emit_fail "Native bridge ping verification failed within ${INITIAL_READINESS_TIMEOUT_SECS}s (expected host PID ${HOST_PID}, marker recorded '${BRIDGE_PING_PID}', resolved failure: ${FAIL_CODE})
${DEBUG_EVIDENCE}" "${FAIL_CODE}"
  fi
fi
log_checkpoint "PHASE3_WAIT_INITIAL_READINESS_OK host_pid=${HOST_PID}"

# Verify Emergency TTYs (TTY2 and TTY3) - MANDATORY AUTOMATED GATE
log_checkpoint "PHASE3_CHECK_EMERGENCY_TTYS_START"

# 1. Verify /proc/cmdline contains nottyautologin (prevents Debian Live automatic-login regression)
CMDLINE_CONTENT="$(cat /proc/cmdline 2>/dev/null || true)"
if ! grep -qw "nottyautologin" /proc/cmdline 2>/dev/null; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID:-unknown}")"
  emit_fail "Emergency TTY regression: /proc/cmdline does not contain 'nottyautologin' parameter (current /proc/cmdline: '${CMDLINE_CONTENT}'). Debian Live automatic login failure will prevent emergency TTY login prompt.
${DEBUG_EVIDENCE}" "emergency_tty_missing_nottyautologin"
fi
log_checkpoint "PHASE3_CHECK_EMERGENCY_TTYS_CMDLINE_OK"

# 2. Verify getty@tty2.service and getty@tty3.service are active
TTY2_STATE="$(systemctl is-active getty@tty2.service 2>/dev/null || echo "inactive")"
TTY3_STATE="$(systemctl is-active getty@tty3.service 2>/dev/null || echo "inactive")"

if [[ "${TTY2_STATE}" != "active" || "${TTY3_STATE}" != "active" ]]; then
  for ((sec=1; sec<=15; sec++)); do
    TTY2_STATE="$(systemctl is-active getty@tty2.service 2>/dev/null || echo "inactive")"
    TTY3_STATE="$(systemctl is-active getty@tty3.service 2>/dev/null || echo "inactive")"
    if [[ "${TTY2_STATE}" == "active" && "${TTY3_STATE}" == "active" ]]; then
      break
    fi
    sleep 1
  done
fi

if [[ "${TTY2_STATE}" != "active" ]]; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID:-unknown}")"
  emit_fail "Emergency TTY failure: getty@tty2.service is '${TTY2_STATE}' (expected 'active')
${DEBUG_EVIDENCE}" "emergency_tty_inactive"
fi
if [[ "${TTY3_STATE}" != "active" ]]; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID:-unknown}")"
  emit_fail "Emergency TTY failure: getty@tty3.service is '${TTY3_STATE}' (expected 'active')
${DEBUG_EVIDENCE}" "emergency_tty_inactive"
fi
log_checkpoint "PHASE3_CHECK_EMERGENCY_TTYS_ACTIVE_OK"

# 3. Verify effective getty configuration is not using an automatic-login option such as --autologin
TTY2_EXECSTART="$(systemctl show getty@tty2.service --property=ExecStart --value 2>/dev/null || true)"
TTY3_EXECSTART="$(systemctl show getty@tty3.service --property=ExecStart --value 2>/dev/null || true)"
TTY2_DROPINS="$(systemctl show getty@tty2.service --property=DropInPaths --value 2>/dev/null || true)"
TTY3_DROPINS="$(systemctl show getty@tty3.service --property=DropInPaths --value 2>/dev/null || true)"

# Check ExecStart definition for autologin arguments (--autologin or -a)
if echo "${TTY2_EXECSTART}" | grep -E -q '(^|[[:space:]])(--autologin|-a([[:space:]]|=|$))'; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID:-unknown}")"
  emit_fail "Emergency TTY regression: getty@tty2.service is configured with automatic-login option: ${TTY2_EXECSTART}
${DEBUG_EVIDENCE}" "emergency_tty2_autologin_detected"
fi
if echo "${TTY3_EXECSTART}" | grep -E -q '(^|[[:space:]])(--autologin|-a([[:space:]]|=|$))'; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID:-unknown}")"
  emit_fail "Emergency TTY regression: getty@tty3.service is configured with automatic-login option: ${TTY3_EXECSTART}
${DEBUG_EVIDENCE}" "emergency_tty3_autologin_detected"
fi

# Check drop-in files for autologin directives
for dropin in ${TTY2_DROPINS} ${TTY3_DROPINS}; do
  if [[ -f "${dropin}" ]] && grep -E -i -q 'autologin' "${dropin}"; then
    DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID:-unknown}")"
    emit_fail "Emergency TTY regression: Drop-in file '${dropin}' contains autologin directive: $(cat "${dropin}")
${DEBUG_EVIDENCE}" "emergency_tty_autologin_dropin_detected"
  fi
done

# Check running agetty process arguments via /proc cmdline
TTY2_PID="$(systemctl show getty@tty2.service --property=MainPID --value 2>/dev/null || true)"
if [[ -n "${TTY2_PID}" && "${TTY2_PID}" =~ ^[0-9]+$ && -r "/proc/${TTY2_PID}/cmdline" ]]; then
  TTY2_PROC_CMD="$(timeout 1s tr '\0' ' ' < "/proc/${TTY2_PID}/cmdline" 2>/dev/null || true)"
  if echo "${TTY2_PROC_CMD}" | grep -E -q '(^|[[:space:]])(--autologin|-a([[:space:]]|=|$))'; then
    DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID:-unknown}")"
    emit_fail "Emergency TTY regression: getty@tty2 process (PID ${TTY2_PID}) running with autologin: ${TTY2_PROC_CMD}
${DEBUG_EVIDENCE}" "emergency_tty2_autologin_running"
  fi
fi

TTY3_PID="$(systemctl show getty@tty3.service --property=MainPID --value 2>/dev/null || true)"
if [[ -n "${TTY3_PID}" && "${TTY3_PID}" =~ ^[0-9]+$ && -r "/proc/${TTY3_PID}/cmdline" ]]; then
  TTY3_PROC_CMD="$(timeout 1s tr '\0' ' ' < "/proc/${TTY3_PID}/cmdline" 2>/dev/null || true)"
  if echo "${TTY3_PROC_CMD}" | grep -E -q '(^|[[:space:]])(--autologin|-a([[:space:]]|=|$))'; then
    DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID:-unknown}")"
    emit_fail "Emergency TTY regression: getty@tty3 process (PID ${TTY3_PID}) running with autologin: ${TTY3_PROC_CMD}
${DEBUG_EVIDENCE}" "emergency_tty3_autologin_running"
  fi
fi

log_checkpoint "PHASE3_CHECK_EMERGENCY_TTYS_OK"

# EMIT PHASE 3 GRAPHICAL BOOT MARKER
log_checkpoint "PHASE3_EMIT_BOOT_MARKER"
SESSION_SCRIPT_PID="$(pgrep -u rocket -f rocketos-session 2>/dev/null | head -n1 || echo 'N/A')"
CAGE_OWNER="$(ps -p "${CAGE_PID}" -o user= 2>/dev/null | tr -d '[:space:]' || echo 'rocket')"
HOST_OWNER="$(ps -p "${HOST_PID}" -o user= 2>/dev/null | tr -d '[:space:]' || echo 'rocket')"
GRAPHICAL_STATUS="$(systemctl is-active rocketos-graphical-session.service 2>/dev/null || echo 'unknown')"
JOURNAL_SNIPPET="$(journalctl -u rocketos-graphical-session.service -n 20 --no-pager 2>/dev/null || true)"

PHASE3_OUTPUT="==================================================
ROCKETOS_PHASE3_GRAPHICAL_BOOT_OK
==================================================
SYSTEM_NAME: RocketOS
PRETTY_NAME: ${PRETTY_NAME}
ID: ${OS_ID}
ID_LIKE: ${OS_ID_LIKE}
VERSION_ID: ${VERSION_ID}
SESSION_TYPE: wayland
COMPOSITOR: cage (PID: ${CAGE_PID}, Owner: ${CAGE_OWNER})
SHELL_HOST: rocket-shell-host (PID: ${HOST_PID}, Owner: ${HOST_OWNER})
SESSION_SCRIPT_PID: ${SESSION_SCRIPT_PID}
RUNTIME: GTK4 + WebKitGTK 6.0
SESSION_USER: rocket (UID: 1000)
SESSION_SERVICE_STATE: ${GRAPHICAL_STATUS}
SYSTEMD_TARGET: graphical.target
UI_LOADED_PID: ${HOST_PID}
BRIDGE_PING_PID: ${HOST_PID}
UI_LOADED_MARKER: verified
BRIDGE_PING_MARKER: verified
EMERGENCY_TTY2: ${TTY2_STATE}
EMERGENCY_TTY3: ${TTY3_STATE}
EMERGENCY_TTY_CMDLINE: verified (nottyautologin present)
EMERGENCY_TTY_AUTOLOGIN: disabled (verified no --autologin)
EMERGENCY_TTY2_EXECSTART: ${TTY2_EXECSTART:-none}
EMERGENCY_TTY3_EXECSTART: ${TTY3_EXECSTART:-none}
KERNEL_UNAME: ${KERNEL_UNAME}
ARCHITECTURE: ${ARCH}
HOSTNAME: $(hostname)
TIMESTAMP_UTC: $(date -u '+%Y-%m-%dT%H:%M:%SZ')
--- GRAPHICAL SESSION RECENT JOURNAL ---
${JOURNAL_SNIPPET}
----------------------------------------
=================================================="

if [ -e /dev/ttyS0 ] && [ -w /dev/ttyS0 ]; then
  echo "${PHASE3_OUTPUT}" > /dev/ttyS0 2>/dev/null || true
fi
echo "${PHASE3_OUTPUT}" >> "${LOG_FILE}" 2>/dev/null || true
echo "${PHASE3_OUTPUT}" > "${TARGET_DEV}" 2>/dev/null || true

# 8. AUTOMATED RUNTIME CRASH RECOVERY VALIDATION (WP5)
log_checkpoint "PHASE3_WP5_RECOVERY_TEST_START"
INITIAL_HOST_PID="${HOST_PID}"
# Keep a real WebKit helper alive across host death: a leaked Cage pipe must
# not let this helper suppress systemd recovery. Plain host kills miss this race.
RECOVERY_HELPER_PID="$(pgrep -P "${INITIAL_HOST_PID}" -f '/WebKitNetworkProcess' | head -n1 || true)"
if [[ -z "${RECOVERY_HELPER_PID}" ]]; then
  emit_fail "WP5 failure: no WebKit network helper available for recovery fault injection" "recovery_failed"
fi
trap 'kill -CONT "${RECOVERY_HELPER_PID}" 2>/dev/null || true' EXIT
kill -STOP "${RECOVERY_HELPER_PID}"
for _ in {1..20}; do
  RECOVERY_HELPER_STATE="$(ps -p "${RECOVERY_HELPER_PID}" -o stat= 2>/dev/null || true)"
  [[ "${RECOVERY_HELPER_STATE}" == T* ]] && break
  sleep 0.05
done
if [[ "${RECOVERY_HELPER_STATE}" != T* ]]; then
  emit_fail "WP5 failure: WebKit helper did not enter stopped state" "recovery_failed"
fi
log_checkpoint "PHASE3_WP5_HELPER_STOPPED pid=${RECOVERY_HELPER_PID}"
log_checkpoint "PHASE3_WP5_KILL_INITIAL_HOST pid=${INITIAL_HOST_PID}"
# Deliberately terminate the host process with SIGKILL
if ! kill -9 "${INITIAL_HOST_PID}" 2>/dev/null; then
  emit_fail "WP5 failure: could not terminate initial shell host" "recovery_failed"
fi

# Wait for systemd RestartSec=2 to relaunch the session
log_checkpoint "PHASE3_WP5_WAIT_RESTART_START"
RESTART_TIMEOUT_SECS=30
RESTART_START_SEC=$(date +%s)
RESTART_DEADLINE=$((RESTART_START_SEC + RESTART_TIMEOUT_SECS))
RESTARTED=false
NEW_CAGE_PID=""
NEW_HOST_PID=""
WP5_ATTEMPT=0

while true; do
  NOW=$(date +%s)
  if [[ ${NOW} -ge ${RESTART_DEADLINE} ]]; then
    break
  fi

  WP5_ATTEMPT=$((WP5_ATTEMPT + 1))
  NEW_CAGE_PID="$(get_authoritative_cage_pid || true)"
  if [[ -n "${NEW_CAGE_PID}" ]]; then
    NEW_PID="$(find_shell_host_pid "${NEW_CAGE_PID}" "${WP5_ATTEMPT}" || true)"
    if [[ -n "${NEW_PID}" && "${NEW_PID}" != "${INITIAL_HOST_PID}" ]]; then
      NEW_HOST_PID="${NEW_PID}"
      RESTARTED=true
      break
    fi
  fi

  NOW_AFTER=$(date +%s)
  if [[ ${NOW_AFTER} -ge ${RESTART_DEADLINE} ]]; then
    break
  fi
  sleep 1
done

if [[ "${RESTARTED}" != "true" || -z "${NEW_HOST_PID}" ]]; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${INITIAL_HOST_PID}")"
  emit_fail "WP5 Failure: rocket-shell-host failed to restart within ${RESTART_TIMEOUT_SECS}s after termination (initial PID: ${INITIAL_HOST_PID})
${DEBUG_EVIDENCE}" "recovery_failed"
fi

if [[ "${NEW_CAGE_PID}" == "${NEW_HOST_PID}" ]]; then
  emit_fail "Internal probe failure during restart: NEW_CAGE_PID (${NEW_CAGE_PID}) == NEW_HOST_PID (${NEW_HOST_PID})" "recovery_failed"
fi
log_checkpoint "PHASE3_WP5_WAIT_RESTART_OK cage_pid=${NEW_CAGE_PID} host_pid=${NEW_HOST_PID}"
RESTART_RECOVERY_SECS=$(( $(date +%s) - RESTART_START_SEC ))
# Release the injected fault only after a replacement has actually appeared.
kill -CONT "${RECOVERY_HELPER_PID}" 2>/dev/null || true
trap - EXIT

# Verify restarted process owner is still rocket
NEW_OWNER="$(timeout 1s ps -p "${NEW_HOST_PID}" -o user= 2>/dev/null | tr -d '[:space:]' || true)"
if [[ "${NEW_OWNER}" != "rocket" ]]; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${NEW_HOST_PID}")"
  emit_fail "WP5 Failure: Restarted rocket-shell-host owner is '${NEW_OWNER}', expected 'rocket'
${DEBUG_EVIDENCE}" "recovery_failed"
fi

# Verify restarted session restored WebKit UI and answered native bridge ping under NEW_HOST_PID
log_checkpoint "PHASE3_WP5_WAIT_RECOVERY_READINESS_START expected_host_pid=${NEW_HOST_PID}"
RECOVERY_READINESS_TIMEOUT_SECS=60
RECOVERED_UI_PID=""
RECOVERED_PING_PID=""

for ((sec=1; sec<=RECOVERY_READINESS_TIMEOUT_SECS; sec++)); do
  if ! kill -0 "${NEW_HOST_PID}" 2>/dev/null; then
    CURRENT_HOSTS="$(find_all_shell_host_pids "${NEW_CAGE_PID}")"
    DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${NEW_HOST_PID}")"
    emit_fail "WP5 Failure: Restarted rocket-shell-host (PID ${NEW_HOST_PID}) unexpectedly died before completing UI recovery (current host PIDs: ${CURRENT_HOSTS:-none})
${DEBUG_EVIDENCE}" "recovery_failed"
  fi

  if [ -f "${UI_LOADED_MARKER}" ] && [ -f "${BRIDGE_PING_MARKER}" ]; then
    RECOVERED_UI_PID="$(head -n1 "${UI_LOADED_MARKER}" 2>/dev/null | tr -d '[:space:]' || true)"
    RECOVERED_PING_PID="$(head -n1 "${BRIDGE_PING_MARKER}" 2>/dev/null | tr -d '[:space:]' || true)"
    if [[ "${RECOVERED_UI_PID}" == "${NEW_HOST_PID}" && "${RECOVERED_PING_PID}" == "${NEW_HOST_PID}" ]]; then
      break
    fi
  fi
  sleep 1
done

if [[ "${RECOVERED_UI_PID}" != "${NEW_HOST_PID}" || "${RECOVERED_PING_PID}" != "${NEW_HOST_PID}" ]]; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${NEW_HOST_PID}")"
  if [[ "${RECOVERED_UI_PID}" != "${NEW_HOST_PID}" ]]; then
    emit_fail "WP5 Failure: Restarted session did not reload diagnostic UI within ${RECOVERY_READINESS_TIMEOUT_SECS}s under new PID (expected ${NEW_HOST_PID}, got '${RECOVERED_UI_PID}')
${DEBUG_EVIDENCE}" "recovery_failed"
  else
    emit_fail "WP5 Failure: Restarted session did not answer bridge ping within ${RECOVERY_READINESS_TIMEOUT_SECS}s under new PID (expected ${NEW_HOST_PID}, got '${RECOVERED_PING_PID}')
${DEBUG_EVIDENCE}" "recovery_failed"
  fi
fi
log_checkpoint "PHASE3_WP5_WAIT_RECOVERY_READINESS_OK host_pid=${NEW_HOST_PID}"

# Verify no accumulating orphan host or cage processes
log_checkpoint "PHASE3_WP5_CHECK_ORPHANS_START"
HOST_COUNT="$(find_all_shell_host_pids "${NEW_CAGE_PID}" | wc -w)"
CAGE_COUNT="$(pgrep -u rocket -x cage 2>/dev/null | wc -l)"
if [[ "${HOST_COUNT}" -ne 1 || "${CAGE_COUNT}" -ne 1 ]]; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${NEW_HOST_PID}")"
  emit_fail "WP5 Failure: Process stack has orphan processes (host_count: ${HOST_COUNT}, cage_count: ${CAGE_COUNT})
${DEBUG_EVIDENCE}" "recovery_failed"
fi
log_checkpoint "PHASE3_WP5_CHECK_ORPHANS_OK"

RECOVERY_CGROUP="$(systemctl status rocketos-graphical-session.service --no-pager 2>/dev/null | grep -E "(CGroup|├─|└─)" || ps -u rocket -o pid,user,args 2>/dev/null || true)"
RECOVERY_JOURNAL="$(journalctl -u rocketos-graphical-session.service -n 20 --no-pager 2>/dev/null || true)"

# Emit WP5 Recovery Success Marker
log_checkpoint "PHASE3_WP5_EMIT_RECOVERY_MARKER"
RECOVERY_OUTPUT="==================================================
ROCKETOS_WP5_RECOVERY_TEST_PASS
==================================================
INITIAL_HOST_PID: ${INITIAL_HOST_PID}
TERMINATION_SIGNAL: SIGKILL
RECOVERY_FAULT: host SIGKILL with stopped WebKit helper
NEW_HOST_PID: ${NEW_HOST_PID}
RESTARTED_USER: ${NEW_OWNER}
RECOVERED_UI_LOADED_PID: ${NEW_HOST_PID}
RECOVERED_BRIDGE_PING_PID: ${NEW_HOST_PID}
ACTIVE_HOST_COUNT: ${HOST_COUNT}
ACTIVE_CAGE_COUNT: ${CAGE_COUNT}
RESTART_RECOVERY_SECS: ${RESTART_RECOVERY_SECS}
TIMESTAMP_UTC: $(date -u '+%Y-%m-%dT%H:%M:%SZ')
--- RECOVERED SESSION CGROUP & PROCESSES ---
${RECOVERY_CGROUP}
--- POST-RECOVERY RECENT JOURNAL ---
${RECOVERY_JOURNAL}
------------------------------------
=================================================="

if [ -e /dev/ttyS0 ] && [ -w /dev/ttyS0 ]; then
  echo "${RECOVERY_OUTPUT}" > /dev/ttyS0 2>/dev/null || true
fi
echo "${RECOVERY_OUTPUT}" >> "${LOG_FILE}" 2>/dev/null || true
echo "${RECOVERY_OUTPUT}" > "${TARGET_DEV}" 2>/dev/null || true

PROBE_COMPLETED=true
touch /run/rocketos-boot-probe-done
kill "${WATCHDOG_PID}" 2>/dev/null || true
log_checkpoint "PHASE3_PROBE_COMPLETE"

exit 0
