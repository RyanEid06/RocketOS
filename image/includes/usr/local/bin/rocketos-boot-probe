#!/bin/bash
# ==============================================================================
# RocketOS Phase 3 Boot Success Probe
# Validates both system foundation and graphical session before emitting:
# ROCKETOS_PHASE2_BOOT_OK
# ROCKETOS_PHASE3_GRAPHICAL_BOOT_OK
# ==============================================================================
set -euo pipefail

TARGET_DEV="/dev/console"
[ -w "$TARGET_DEV" ] || TARGET_DEV="/dev/stdout"
LOG_FILE="/var/log/rocketos-boot-probe.log"
mkdir -p "$(dirname "$LOG_FILE")"

emit_fail() {
  local reason="$1"
  local output="==================================================
ROCKETOS_BOOT_FAIL
==================================================
FAILURE_REASON: ${reason}
TIMESTAMP_UTC: $(date -u '+%Y-%m-%dT%H:%M:%SZ')
=================================================="

  echo "${output}" | tee -a "${LOG_FILE}" > "${TARGET_DEV}" 2>/dev/null || true
  if [ -e /dev/ttyS0 ] && [ -w /dev/ttyS0 ]; then
    echo "${output}" > /dev/ttyS0 2>/dev/null || true
  fi
  exit 1
}

# 1. Verify kernel is running and responsive
if [ ! -f /proc/version ]; then
  emit_fail "/proc/version not found; kernel virtual filesystem is not accessible"
fi

KERNEL_UNAME="$(uname -srmo 2>/dev/null || true)"
if [[ -z "${KERNEL_UNAME}" ]]; then
  emit_fail "uname command failed to report kernel information"
fi

KERNEL_RELEASE="$(uname -r 2>/dev/null || true)"

# 2. Verify architecture is x86_64
ARCH="$(uname -m 2>/dev/null || true)"
if [[ "${ARCH}" != "x86_64" ]]; then
  emit_fail "Architecture is '${ARCH}', expected 'x86_64'"
fi

# 3. Verify PID 1 / init system is systemd
INIT_NAME=""
if [ -r /proc/1/comm ]; then
  INIT_NAME="$(cat /proc/1/comm 2>/dev/null || true)"
fi
if [[ -z "${INIT_NAME}" ]]; then
  INIT_NAME="$(ps -p 1 -o comm= 2>/dev/null || true)"
fi
if [[ "${INIT_NAME}" != "systemd" ]]; then
  emit_fail "PID 1 is '${INIT_NAME}', expected 'systemd'"
fi

# 4. Verify systemd health state (multi-user.target reached and active)
for _ in {1..30}; do
  if systemctl is-active --quiet multi-user.target 2>/dev/null; then
    break
  fi
  sleep 1
done

if ! systemctl is-active --quiet multi-user.target 2>/dev/null; then
  emit_fail "systemd multi-user.target is not active"
fi

# 5. Verify systemd startup settlement
SYSTEMD_STATE="$(systemctl is-system-running 2>/dev/null || true)"
for _ in {1..30}; do
  if [[ "${SYSTEMD_STATE}" == "running" || "${SYSTEMD_STATE}" == "degraded" ]]; then
    break
  fi
  sleep 1
  SYSTEMD_STATE="$(systemctl is-system-running 2>/dev/null || true)"
done

# 6. Verify /etc/os-release identity
if [ ! -f /etc/os-release ]; then
  emit_fail "/etc/os-release does not exist"
fi

OS_ID="$(grep '^ID=' /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '"' || true)"
if [[ "${OS_ID}" != "rocketos" ]]; then
  emit_fail "/etc/os-release ID is '${OS_ID}', expected 'rocketos'"
fi

OS_ID_LIKE="$(grep '^ID_LIKE=' /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '"' || true)"
if [[ ! "${OS_ID_LIKE}" =~ (^|[[:space:]])debian([[:space:]]|$) ]]; then
  emit_fail "/etc/os-release ID_LIKE is '${OS_ID_LIKE}', expected to contain 'debian'"
fi

PRETTY_NAME="$(grep '^PRETTY_NAME=' /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '"' || true)"
VERSION_ID="$(grep '^VERSION_ID=' /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '"' || true)"
SYSTEMD_VERSION="$(systemctl --version 2>/dev/null | head -n1 | awk '{print $2}' || true)"

# EMIT PHASE 2 MARKER FOR REGRESSION VERIFICATION
PHASE2_OUTPUT="==================================================
ROCKETOS_PHASE2_BOOT_OK
==================================================
SYSTEM_NAME: RocketOS
PRETTY_NAME: ${PRETTY_NAME}
ID: ${OS_ID}
ID_LIKE: ${OS_ID_LIKE}
VERSION_ID: ${VERSION_ID}
KERNEL_UNAME: ${KERNEL_UNAME}
KERNEL_RELEASE: ${KERNEL_RELEASE}
ARCHITECTURE: ${ARCH}
HOSTNAME: $(hostname)
SYSTEMD_STATE: ${SYSTEMD_STATE}
INIT_SYSTEM: systemd ${SYSTEMD_VERSION}
TIMESTAMP_UTC: $(date -u '+%Y-%m-%dT%H:%M:%SZ')
=================================================="

echo "${PHASE2_OUTPUT}" | tee -a "${LOG_FILE}" > "${TARGET_DEV}" 2>/dev/null || true
if [ -e /dev/ttyS0 ] && [ -w /dev/ttyS0 ]; then
  echo "${PHASE2_OUTPUT}" > /dev/ttyS0 2>/dev/null || true
fi

# 7. PHASE 3 GRAPHICAL VERIFICATION
# 7a. Verify configured default target is graphical.target
DEFAULT_TARGET="$(systemctl get-default 2>/dev/null || true)"
if [[ "${DEFAULT_TARGET}" != "graphical.target" ]]; then
  emit_fail "Configured default systemd target is '${DEFAULT_TARGET}', expected 'graphical.target'"
fi

# 7b. Wait for and require rocketos-graphical-session.service to be active
# Note: rocketos-boot-probe runs as a Type=oneshot service WantedBy=graphical.target.
# Therefore, graphical.target remains in 'activating' state until the probe completes.
# Checking 'systemctl is-active graphical.target' inside the probe creates a circular
# dependency deadlock. We verify default target above and wait directly for the session service.
GRAPHICAL_ACTIVE=false
for _ in {1..35}; do
  if systemctl is-active --quiet rocketos-graphical-session.service 2>/dev/null; then
    GRAPHICAL_ACTIVE=true
    break
  fi
  sleep 1
done

if [[ "${GRAPHICAL_ACTIVE}" != "true" ]]; then
  SESSION_STATE="$(systemctl is-active rocketos-graphical-session.service 2>/dev/null || echo "inactive")"
  SESSION_STATUS="$(systemctl status rocketos-graphical-session.service --no-pager 2>/dev/null || true)"
  SESSION_JOURNAL="$(journalctl -u rocketos-graphical-session.service -n 50 --no-pager 2>/dev/null || true)"
  emit_fail "rocketos-graphical-session.service failed to activate (service state: ${SESSION_STATE})
--- SERVICE STATUS ---
${SESSION_STATUS}
--- SERVICE JOURNAL ---
${SESSION_JOURNAL}"
fi


# Verify unprivileged user rocket
if ! id rocket >/dev/null 2>&1; then
  emit_fail "Dedicated unprivileged user 'rocket' does not exist"
fi

# Process Discovery Helpers
# ------------------------------------------------------------------------------
# Authoritatively identify Cage PID from systemd service or exact comm
get_authoritative_cage_pid() {
  local cage_pid=""
  cage_pid="$(systemctl show --property=MainPID --value rocketos-graphical-session.service 2>/dev/null || true)"
  if [[ -z "${cage_pid}" || "${cage_pid}" == "0" ]]; then
    cage_pid="$(pgrep -u rocket -x cage 2>/dev/null | head -n1 || true)"
  fi
  echo "${cage_pid}"
}

# Authoritatively test whether a PID corresponds to rocket-shell-host
is_shell_host_process() {
  local pid="$1"
  local cage_pid="${2:-}"

  [[ -n "${pid}" && -d "/proc/${pid}" ]] || return 1
  [[ -n "${cage_pid}" && "${pid}" == "${cage_pid}" ]] && return 1

  # Must be owned by rocket
  local owner
  owner="$(ps -p "${pid}" -o user= 2>/dev/null | tr -d '[:space:]' || true)"
  [[ "${owner}" == "rocket" ]] || return 1

  # Comm must NOT be cage, bwrap, or WebKit subprocesses
  local comm
  comm="$(cat "/proc/${pid}/comm" 2>/dev/null || true)"
  if [[ "${comm}" == "cage" || "${comm}" =~ ^WebKit || "${comm}" == "bwrap" ]]; then
    return 1
  fi

  # Inspect cmdline (NUL-separated)
  local first_arg
  first_arg="$(head -z -n 1 "/proc/${pid}/cmdline" 2>/dev/null || echo "")"
  if [[ "${first_arg}" == *"cage"* ]]; then
    return 1
  fi

  local cmdline
  cmdline="$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null || true)"
  if [[ "${cmdline}" == *"rocket-shell-host"* ]]; then
    return 0
  fi

  return 1
}

# Discover authoritative shell-host PID: inspect Cage children first, then user rocket processes
find_shell_host_pid() {
  local cage_pid="${1:-}"

  if [[ -n "${cage_pid}" && -d "/proc/${cage_pid}" ]]; then
    local children=""
    if [[ -f "/proc/${cage_pid}/task/${cage_pid}/children" ]]; then
      children="$(cat "/proc/${cage_pid}/task/${cage_pid}/children" 2>/dev/null || true)"
    fi
    if [[ -z "${children}" ]]; then
      children="$(pgrep -P "${cage_pid}" 2>/dev/null || true)"
    fi
    for child in ${children}; do
      if is_shell_host_process "${child}" "${cage_pid}"; then
        echo "${child}"
        return 0
      fi
    done
  fi

  # Fallback: scan all processes owned by user rocket
  for p in $(pgrep -u rocket 2>/dev/null || true); do
    if is_shell_host_process "${p}" "${cage_pid}"; then
      echo "${p}"
      return 0
    fi
  done

  return 1
}

# Find all shell-host PIDs (to detect duplicates or orphan processes)
find_all_shell_host_pids() {
  local cage_pid="${1:-}"
  local pids=()
  for p in $(pgrep -u rocket 2>/dev/null || true); do
    if is_shell_host_process "${p}" "${cage_pid}"; then
      pids+=("${p}")
    fi
  done
  echo "${pids[@]:-}"
}

# Verify processes running under user rocket
HOST_PID=""
CAGE_PID=""
for _ in {1..25}; do
  CAGE_PID="$(get_authoritative_cage_pid || true)"
  if [[ -n "${CAGE_PID}" ]]; then
    HOST_PID="$(find_shell_host_pid "${CAGE_PID}" || true)"
  fi
  if [[ -n "${HOST_PID}" && -n "${CAGE_PID}" ]]; then
    break
  fi
  sleep 1
done

if [[ -z "${CAGE_PID}" ]]; then
  emit_fail "cage compositor is not running under user rocket"
fi
if [[ -z "${HOST_PID}" ]]; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "none")"
  emit_fail "rocket-shell-host is not running under user rocket
${DEBUG_EVIDENCE}"
fi
if [[ "${CAGE_PID}" == "${HOST_PID}" ]]; then
  emit_fail "Internal probe failure: CAGE_PID (${CAGE_PID}) was identified as HOST_PID"
fi

ROCKET_UID="$(id -u rocket 2>/dev/null || echo 1000)"
RUNTIME_DIR="/run/user/${ROCKET_UID}"
UI_LOADED_MARKER="${RUNTIME_DIR}/rocketos-ui-loaded"
BRIDGE_PING_MARKER="${RUNTIME_DIR}/rocketos-bridge-ping-ok"

collect_graphical_debug_evidence() {
  local target_pid="${1:-${HOST_PID:-unknown}}"
  local cage_pid
  cage_pid="$(get_authoritative_cage_pid || true)"
  local cage_cmdline="(cage cmdline unavailable)"
  local cage_children="(none)"
  if [[ -n "${cage_pid}" && -d "/proc/${cage_pid}" ]]; then
    cage_cmdline="$(tr '\0' ' ' < "/proc/${cage_pid}/cmdline" 2>/dev/null || echo '(read failed)')"
    if [[ -f "/proc/${cage_pid}/task/${cage_pid}/children" ]]; then
      cage_children="$(cat "/proc/${cage_pid}/task/${cage_pid}/children" 2>/dev/null || true)"
    fi
    if [[ -z "${cage_children}" ]]; then
      cage_children="$(pgrep -P "${cage_pid}" 2>/dev/null | tr '\n' ' ' || echo 'none')"
    fi
  fi

  local host_cmdline="(host cmdline unavailable)"
  local host_ppid="(unavailable)"
  if [[ -n "${target_pid}" && -d "/proc/${target_pid}" ]]; then
    host_cmdline="$(tr '\0' ' ' < "/proc/${target_pid}/cmdline" 2>/dev/null || echo '(read failed)')"
    host_ppid="$(ps -p "${target_pid}" -o ppid= 2>/dev/null | tr -d '[:space:]' || echo 'unknown')"
  fi

  local current_hosts
  current_hosts="$(find_all_shell_host_pids "${cage_pid}")"
  [[ -z "${current_hosts}" ]] && current_hosts="none"

  local all_cage_pids
  all_cage_pids="$(pgrep -u rocket -x cage 2>/dev/null | tr '\n' ' ' || echo 'none')"

  local session_state
  session_state="$(systemctl is-active rocketos-graphical-session.service 2>/dev/null || echo 'unknown')"
  local session_status
  session_status="$(systemctl status rocketos-graphical-session.service --no-pager 2>/dev/null || echo '(status unavailable)')"
  local session_journal
  session_journal="$(journalctl -u rocketos-graphical-session.service -n 50 --no-pager 2>/dev/null || echo '(journal unavailable)')"
  local run_user_listing
  run_user_listing="$(ls -la "/run/user/${ROCKET_UID}" 2>/dev/null || echo "(listing failed for /run/user/${ROCKET_UID})")"

  local pstree_out="(pstree unavailable)"
  if command -v pstree >/dev/null 2>&1; then
    if [[ -n "${cage_pid}" && -d "/proc/${cage_pid}" ]]; then
      pstree_out="$(pstree -ap "${cage_pid}" 2>/dev/null || echo '(pstree failed)')"
    else
      pstree_out="$(pstree -ap -u rocket 2>/dev/null || echo '(pstree failed)')"
    fi
  fi

  local ps_rocket_out
  ps_rocket_out="$(ps -u rocket -o pid,ppid,user,stat,comm,args 2>/dev/null || true)"
  local ps_ef_snippet
  ps_ef_snippet="$(ps -ef 2>/dev/null || true)"

  local ui_val="(file not present)"
  [ -f "${UI_LOADED_MARKER}" ] && ui_val="$(cat "${UI_LOADED_MARKER}" 2>/dev/null || echo '(read failed)')"
  local ping_val="(file not present)"
  [ -f "${BRIDGE_PING_MARKER}" ] && ping_val="$(cat "${BRIDGE_PING_MARKER}" 2>/dev/null || echo '(read failed)')"

  local webkit_err="(no webkit error recorded)"
  local webkit_err_file="/run/user/${ROCKET_UID}/rocketos-webkit-error"
  [ -f "${webkit_err_file}" ] && webkit_err="$(cat "${webkit_err_file}" 2>/dev/null || echo '(read failed)')"

  cat <<EOF
--- GRAPHICAL RUNTIME DIAGNOSTIC EVIDENCE ---
Expected Host PID:        ${target_pid}
Host Parent PID:          ${host_ppid}
Host Cmdline:             ${host_cmdline}
Current Host PID(s):      ${current_hosts}
Cage PID:                 ${cage_pid}
Cage Cmdline:             ${cage_cmdline}
Cage Children:            ${cage_children}
All Cage PID(s):          ${all_cage_pids}
Graphical Service State:  ${session_state}
UI Marker Value:          '${ui_val}'
Bridge Ping Marker Value: '${ping_val}'
WebKit Load Error File:
${webkit_err}
Contents of /run/user/${ROCKET_UID}:
${run_user_listing}
PSTREE:
${pstree_out}
Processes Owned by rocket (ps -u rocket -o pid,ppid,user,stat,comm,args):
${ps_rocket_out}
All Processes (ps -ef):
${ps_ef_snippet}
Service Status:
${session_status}
Recent Service Journal:
${session_journal}
---------------------------------------------
EOF
}

# Verify Diagnostic WebKit UI loaded and Native Bridge ping answered
# Bounded timeout (60 seconds) safe for software-rendered WebKitGTK under QEMU TCG
INITIAL_READINESS_TIMEOUT_SECS=60
UI_LOADED_PID=""
BRIDGE_PING_PID=""

for ((sec=1; sec<=INITIAL_READINESS_TIMEOUT_SECS; sec++)); do
  # Verify that the expected host process has not prematurely died or crash-looped
  if ! kill -0 "${HOST_PID}" 2>/dev/null; then
    CURRENT_HOSTS="$(find_all_shell_host_pids "${CAGE_PID}")"
    DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID}")"
    emit_fail "Initial rocket-shell-host (PID ${HOST_PID}) unexpectedly terminated before completing UI readiness (current host PIDs: ${CURRENT_HOSTS:-none})
${DEBUG_EVIDENCE}"
  fi

  if [ -f "${UI_LOADED_MARKER}" ] && [ -f "${BRIDGE_PING_MARKER}" ]; then
    UI_LOADED_PID="$(head -n1 "${UI_LOADED_MARKER}" 2>/dev/null | tr -d '[:space:]' || true)"
    BRIDGE_PING_PID="$(head -n1 "${BRIDGE_PING_MARKER}" 2>/dev/null | tr -d '[:space:]' || true)"
    if [[ "${UI_LOADED_PID}" == "${HOST_PID}" && "${BRIDGE_PING_PID}" == "${HOST_PID}" ]]; then
      break
    fi
  fi
  sleep 1
done

if [[ "${UI_LOADED_PID}" != "${HOST_PID}" || "${BRIDGE_PING_PID}" != "${HOST_PID}" ]]; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${HOST_PID}")"
  if [[ "${UI_LOADED_PID}" != "${HOST_PID}" ]]; then
    emit_fail "Diagnostic UI failed to complete loading within ${INITIAL_READINESS_TIMEOUT_SECS}s (expected host PID ${HOST_PID}, marker recorded '${UI_LOADED_PID}')
${DEBUG_EVIDENCE}"
  else
    emit_fail "Native bridge ping verification failed within ${INITIAL_READINESS_TIMEOUT_SECS}s (expected host PID ${HOST_PID}, marker recorded '${BRIDGE_PING_PID}')
${DEBUG_EVIDENCE}"
  fi
fi

# Verify Emergency TTYs (TTY2 and TTY3) - MANDATORY AUTOMATED GATE
TTY2_STATE="$(systemctl is-active getty@tty2.service 2>/dev/null || echo "inactive")"
TTY3_STATE="$(systemctl is-active getty@tty3.service 2>/dev/null || echo "inactive")"

if [[ "${TTY2_STATE}" != "active" || "${TTY3_STATE}" != "active" ]]; then
  for _ in {1..15}; do
    TTY2_STATE="$(systemctl is-active getty@tty2.service 2>/dev/null || echo "inactive")"
    TTY3_STATE="$(systemctl is-active getty@tty3.service 2>/dev/null || echo "inactive")"
    if [[ "${TTY2_STATE}" == "active" && "${TTY3_STATE}" == "active" ]]; then
      break
    fi
    sleep 1
  done
fi

if [[ "${TTY2_STATE}" != "active" ]]; then
  emit_fail "Emergency TTY failure: getty@tty2.service is '${TTY2_STATE}' (expected 'active')"
fi
if [[ "${TTY3_STATE}" != "active" ]]; then
  emit_fail "Emergency TTY failure: getty@tty3.service is '${TTY3_STATE}' (expected 'active')"
fi

SESSION_SCRIPT_PID="$(pgrep -u rocket -f rocketos-session | head -n1 || echo 'N/A')"
CAGE_OWNER="$(ps -p "${CAGE_PID}" -o user= 2>/dev/null | tr -d '[:space:]' || echo 'rocket')"
HOST_OWNER="$(ps -p "${HOST_PID}" -o user= 2>/dev/null | tr -d '[:space:]' || echo 'rocket')"
GRAPHICAL_STATUS="$(systemctl is-active rocketos-graphical-session.service 2>/dev/null || echo 'unknown')"
JOURNAL_SNIPPET="$(journalctl -u rocketos-graphical-session.service -n 20 --no-pager 2>/dev/null || true)"

# EMIT PHASE 3 GRAPHICAL BOOT MARKER
PHASE3_OUTPUT="==================================================
ROCKETOS_PHASE3_GRAPHICAL_BOOT_OK
==================================================
SYSTEM_NAME: RocketOS
PRETTY_NAME: ${PRETTY_NAME}
ID: ${OS_ID}
ID_LIKE: ${OS_ID_LIKE}
VERSION_ID: ${VERSION_ID}
SESSION_TYPE: wayland
COMPOSITOR: cage (PID: ${CAGE_PID}, Owner: ${CAGE_OWNER})
SHELL_HOST: rocket-shell-host (PID: ${HOST_PID}, Owner: ${HOST_OWNER})
SESSION_SCRIPT_PID: ${SESSION_SCRIPT_PID}
RUNTIME: GTK4 + WebKitGTK 6.0
SESSION_USER: rocket (UID: 1000)
SESSION_SERVICE_STATE: ${GRAPHICAL_STATUS}
SYSTEMD_TARGET: graphical.target
UI_LOADED_PID: ${HOST_PID}
BRIDGE_PING_PID: ${HOST_PID}
UI_LOADED_MARKER: verified
BRIDGE_PING_MARKER: verified
EMERGENCY_TTY2: ${TTY2_STATE}
EMERGENCY_TTY3: ${TTY3_STATE}
KERNEL_UNAME: ${KERNEL_UNAME}
ARCHITECTURE: ${ARCH}
HOSTNAME: $(hostname)
TIMESTAMP_UTC: $(date -u '+%Y-%m-%dT%H:%M:%SZ')
--- GRAPHICAL SESSION RECENT JOURNAL ---
${JOURNAL_SNIPPET}
----------------------------------------
=================================================="

echo "${PHASE3_OUTPUT}" | tee -a "${LOG_FILE}" > "${TARGET_DEV}" 2>/dev/null || true
if [ -e /dev/ttyS0 ] && [ -w /dev/ttyS0 ]; then
  echo "${PHASE3_OUTPUT}" > /dev/ttyS0 2>/dev/null || true
fi

# 8. AUTOMATED RUNTIME CRASH RECOVERY VALIDATION (WP5)
echo "[boot-probe] Commencing automated controlled crash recovery validation..."

INITIAL_HOST_PID="${HOST_PID}"
# Deliberately terminate the host process with SIGKILL
kill -9 "${INITIAL_HOST_PID}" 2>/dev/null || true

# Wait for systemd RestartSec=2 to relaunch the session
RESTART_TIMEOUT_SECS=30
RESTARTED=false
NEW_CAGE_PID=""
NEW_HOST_PID=""
for ((sec=1; sec<=RESTART_TIMEOUT_SECS; sec++)); do
  NEW_CAGE_PID="$(get_authoritative_cage_pid || true)"
  if [[ -n "${NEW_CAGE_PID}" ]]; then
    NEW_PID="$(find_shell_host_pid "${NEW_CAGE_PID}" || true)"
    if [[ -n "${NEW_PID}" && "${NEW_PID}" != "${INITIAL_HOST_PID}" ]]; then
      NEW_HOST_PID="${NEW_PID}"
      RESTARTED=true
      break
    fi
  fi
  sleep 1
done

if [[ "${RESTARTED}" != "true" || -z "${NEW_HOST_PID}" ]]; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${INITIAL_HOST_PID}")"
  emit_fail "WP5 Failure: rocket-shell-host failed to restart within ${RESTART_TIMEOUT_SECS}s after termination (initial PID: ${INITIAL_HOST_PID})
${DEBUG_EVIDENCE}"
fi

if [[ "${NEW_CAGE_PID}" == "${NEW_HOST_PID}" ]]; then
  emit_fail "Internal probe failure during restart: NEW_CAGE_PID (${NEW_CAGE_PID}) == NEW_HOST_PID (${NEW_HOST_PID})"
fi

# Verify restarted process owner is still rocket
NEW_OWNER="$(ps -p "${NEW_HOST_PID}" -o user= 2>/dev/null | tr -d '[:space:]' || true)"
if [[ "${NEW_OWNER}" != "rocket" ]]; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${NEW_HOST_PID}")"
  emit_fail "WP5 Failure: Restarted rocket-shell-host owner is '${NEW_OWNER}', expected 'rocket'
${DEBUG_EVIDENCE}"
fi

# Verify restarted session restored WebKit UI and answered native bridge ping under NEW_HOST_PID
RECOVERY_READINESS_TIMEOUT_SECS=60
RECOVERED_UI_PID=""
RECOVERED_PING_PID=""

for ((sec=1; sec<=RECOVERY_READINESS_TIMEOUT_SECS; sec++)); do
  if ! kill -0 "${NEW_HOST_PID}" 2>/dev/null; then
    CURRENT_HOSTS="$(find_all_shell_host_pids "${NEW_CAGE_PID}")"
    DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${NEW_HOST_PID}")"
    emit_fail "WP5 Failure: Restarted rocket-shell-host (PID ${NEW_HOST_PID}) unexpectedly died before completing UI recovery (current host PIDs: ${CURRENT_HOSTS:-none})
${DEBUG_EVIDENCE}"
  fi

  if [ -f "${UI_LOADED_MARKER}" ] && [ -f "${BRIDGE_PING_MARKER}" ]; then
    RECOVERED_UI_PID="$(head -n1 "${UI_LOADED_MARKER}" 2>/dev/null | tr -d '[:space:]' || true)"
    RECOVERED_PING_PID="$(head -n1 "${BRIDGE_PING_MARKER}" 2>/dev/null | tr -d '[:space:]' || true)"
    if [[ "${RECOVERED_UI_PID}" == "${NEW_HOST_PID}" && "${RECOVERED_PING_PID}" == "${NEW_HOST_PID}" ]]; then
      break
    fi
  fi
  sleep 1
done

if [[ "${RECOVERED_UI_PID}" != "${NEW_HOST_PID}" || "${RECOVERED_PING_PID}" != "${NEW_HOST_PID}" ]]; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${NEW_HOST_PID}")"
  if [[ "${RECOVERED_UI_PID}" != "${NEW_HOST_PID}" ]]; then
    emit_fail "WP5 Failure: Restarted session did not reload diagnostic UI within ${RECOVERY_READINESS_TIMEOUT_SECS}s under new PID (expected ${NEW_HOST_PID}, got '${RECOVERED_UI_PID}')
${DEBUG_EVIDENCE}"
  else
    emit_fail "WP5 Failure: Restarted session did not answer bridge ping within ${RECOVERY_READINESS_TIMEOUT_SECS}s under new PID (expected ${NEW_HOST_PID}, got '${RECOVERED_PING_PID}')
${DEBUG_EVIDENCE}"
  fi
fi

# Verify no accumulating orphan host or cage processes
HOST_COUNT="$(find_all_shell_host_pids "${NEW_CAGE_PID}" | wc -w)"
CAGE_COUNT="$(pgrep -u rocket -x cage | wc -l)"
if [[ "${HOST_COUNT}" -ne 1 || "${CAGE_COUNT}" -ne 1 ]]; then
  DEBUG_EVIDENCE="$(collect_graphical_debug_evidence "${NEW_HOST_PID}")"
  emit_fail "WP5 Failure: Process stack has orphan processes (host_count: ${HOST_COUNT}, cage_count: ${CAGE_COUNT})
${DEBUG_EVIDENCE}"
fi

RECOVERY_CGROUP="$(systemctl status rocketos-graphical-session.service --no-pager 2>/dev/null | grep -E "(CGroup|├─|└─)" || ps -u rocket -o pid,user,args || true)"
RECOVERY_JOURNAL="$(journalctl -u rocketos-graphical-session.service -n 20 --no-pager 2>/dev/null || true)"

# Emit WP5 Recovery Success Marker
RECOVERY_OUTPUT="==================================================
ROCKETOS_WP5_RECOVERY_TEST_PASS
==================================================
INITIAL_HOST_PID: ${INITIAL_HOST_PID}
TERMINATION_SIGNAL: SIGKILL
NEW_HOST_PID: ${NEW_HOST_PID}
RESTARTED_USER: ${NEW_OWNER}
RECOVERED_UI_LOADED_PID: ${NEW_HOST_PID}
RECOVERED_BRIDGE_PING_PID: ${NEW_HOST_PID}
ACTIVE_HOST_COUNT: ${HOST_COUNT}
ACTIVE_CAGE_COUNT: ${CAGE_COUNT}
RESTART_RECOVERY_SECS: 2
TIMESTAMP_UTC: $(date -u '+%Y-%m-%dT%H:%M:%SZ')
--- RECOVERED SESSION CGROUP & PROCESSES ---
${RECOVERY_CGROUP}
--- POST-RECOVERY RECENT JOURNAL ---
${RECOVERY_JOURNAL}
------------------------------------
=================================================="

echo "${RECOVERY_OUTPUT}" | tee -a "${LOG_FILE}" > "${TARGET_DEV}" 2>/dev/null || true
if [ -e /dev/ttyS0 ] && [ -w /dev/ttyS0 ]; then
  echo "${RECOVERY_OUTPUT}" > /dev/ttyS0 2>/dev/null || true
fi

exit 0
