# RocketOS Paint Domain Model & .rpaint Vector/Raster Engine
# Authoritative definitions for strokes, shapes, canvas presets, and document serialization

import std.string
import std.collections
import std.time

enum PaintTool:
    Brush
    Eraser
    Line
    Rectangle
    FilledRectangle
    Circle
    FilledCircle
    Picker

struct Point2D:
    x: Float
    y: Float

struct CanvasDimensions:
    width: Int
    height: Int

struct StrokeRecord:
    id: String
    tool: PaintTool
    color: String
    brush_size: Int
    points: Array[Point2D]
    start_point: Point2D
    end_point: Point2D
    timestamp: String

struct PaintDocument:
    id: String
    title: String
    dimensions: CanvasDimensions
    background_color: String
    strokes: Array[StrokeRecord]
    created_at: String
    modified_at: String
    file_path: String
    is_dirty: Bool
    zoom_percent: Int

fn tool_to_string(tool: PaintTool) -> String:
    match tool:
        case Brush: return "brush"
        case Eraser: return "eraser"
        case Line: return "line"
        case Rectangle: return "rectangle"
        case FilledRectangle: return "filled_rectangle"
        case Circle: return "circle"
        case FilledCircle: return "filled_circle"
        case Picker: return "picker"

fn tool_from_string(raw: String) -> PaintTool:
    if raw == "eraser":
        return Eraser
    if raw == "line":
        return Line
    if raw == "rectangle":
        return Rectangle
    if raw == "filled_rectangle":
        return FilledRectangle
    if raw == "circle":
        return Circle
    if raw == "filled_circle":
        return FilledCircle
    if raw == "picker":
        return Picker
    return Brush

fn create_default_paint_document(title: String, w: Int, h: Int) -> PaintDocument:
    let now = time.now_iso()
    return PaintDocument(
        id: "paint-" + string.from_int(time.timestamp_ms()),
        title: title,
        dimensions: CanvasDimensions(width: w, height: h),
        background_color: "#1e293b",
        strokes: [],
        created_at: now,
        modified_at: now,
        file_path: "",
        is_dirty: false,
        zoom_percent: 100
    )

fn format_rpaint_json(doc: PaintDocument) -> String:
    var json = "{\n"
    json = json + "  \"format\": \"rocket-paint-v1\",\n"
    json = json + "  \"id\": \"" + doc.id + "\",\n"
    json = json + "  \"title\": \"" + doc.title + "\",\n"
    json = json + "  \"width\": " + string.from_int(doc.dimensions.width) + ",\n"
    json = json + "  \"height\": " + string.from_int(doc.dimensions.height) + ",\n"
    json = json + "  \"backgroundColor\": \"" + doc.background_color + "\",\n"
    json = json + "  \"createdAt\": \"" + doc.created_at + "\",\n"
    json = json + "  \"modifiedAt\": \"" + doc.modified_at + "\",\n"
    json = json + "  \"totalStrokes\": " + string.from_int(collections.length(doc.strokes)) + "\n"
    json = json + "}"
    return json

struct CanvasPreset:
    name: String
    width: Int
    height: Int
    description: String

fn get_standard_presets() -> Array[CanvasPreset]:
    return [
        CanvasPreset(name: "VGA Retro", width: 640, height: 480, description: "Classic 4:3 CRT resolution"),
        CanvasPreset(name: "HD Compact", width: 800, height: 600, description: "Balanced workstation ratio"),
        CanvasPreset(name: "Widescreen", width: 900, height: 560, description: "RocketOS default canvas"),
        CanvasPreset(name: "720p Canvas", width: 1280, height: 720, description: "16:9 widescreen artwork"),
        CanvasPreset(name: "Square Icon", width: 512, height: 512, description: "1:1 App icon or texture asset")
    ]
