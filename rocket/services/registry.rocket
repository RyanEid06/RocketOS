            constraints: WindowConstraints(850, 530, 550, 380),
            supported_extensions: [],
            keywords: ["raylib", "physics", "2d", "engine", "graphics", "orbit", "simulation"],
            is_system_app: false
        )
    ]

fn find_app_by_id(apps: List[AppDescriptor], id: String) -> Option[AppDescriptor]:
    for app in apps:
        if app.id == id:
            return Some(app)
    return None

fn main() -> Int:
    let apps = get_registered_apps()
    print("Registered Apps in RocketOS: " + string.from_int(apps.length))
    return 0
