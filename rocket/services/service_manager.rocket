            description: "Host link monitoring, DNS simulation, and socket telemetry",
            startup_mode: StartupMode.Boot,
            dependencies: ["rocket-init"],
            is_critical: false,
            assigned_uid: 0
        ),
        ServiceDefinition(
            id: "rocket-indexer",
            name: "Universal Desktop Search Indexer",
