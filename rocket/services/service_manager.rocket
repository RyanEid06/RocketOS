// RocketOS Service Manager Domain Model
// Daemon lifecycles, startup dependency verification, and system supervisor state

import std.string
import std.collections

enum ServiceState:
    Starting
    Running
    Stopping
    Stopped
    Failed

enum StartupMode:
    Boot
    Demand
    Disabled

struct ServiceDefinition:
    id: String
    name: String
    description: String
    startup_mode: StartupMode
    dependencies: List[String]
    is_critical: Bool
    assigned_uid: Int

struct ServiceInstance:
    id: String
    name: String
    state: ServiceState
    startup_mode: StartupMode
    dependencies: List[String]
    start_time_epoch_ms: Int
    restart_count: Int
    status_message: String
    capabilities: List[String]
    process_id: Int

fn format_service_state(state: ServiceState) -> String:
    match state:
        case Starting:
            return "STARTING"
        case Running:
            return "RUNNING"
        case Stopping:
            return "STOPPING"
        case Stopped:
            return "STOPPED"
        case Failed:
            return "FAILED"

fn format_startup_mode(mode: StartupMode) -> String:
    match mode:
        case Boot:
            return "boot"
        case Demand:
            return "demand"
        case Disabled:
            return "disabled"

fn can_service_transition(from_state: ServiceState, to_state: ServiceState) -> Bool:
    match from_state:
        case Stopped:
            return to_state == ServiceState.Starting or to_state == ServiceState.Failed
        case Starting:
            return to_state == ServiceState.Running or to_state == ServiceState.Failed or to_state == ServiceState.Stopped
        case Running:
            return to_state == ServiceState.Stopping or to_state == ServiceState.Failed or to_state == ServiceState.Stopped
        case Stopping:
            return to_state == ServiceState.Stopped or to_state == ServiceState.Failed
        case Failed:
            return to_state == ServiceState.Starting or to_state == ServiceState.Stopped

fn are_dependencies_satisfied(dependencies: List[String], running_services: List[String]) -> Bool:
    for dep in dependencies:
        var found = false
        for running in running_services:
            if dep == running:
                found = true
                break
        if not found:
            return false
    return true

fn get_core_service_definitions() -> List[ServiceDefinition]:
    return [
        ServiceDefinition(
            id: "rocket-init",
            name: "RocketOS System Bootstrap Daemon",
            description: "PID 1 core orchestrator, hardware abstraction, and lifecycle root",
            startup_mode: StartupMode.Boot,
            dependencies: [],
            is_critical: true,
            assigned_uid: 0
        ),
        ServiceDefinition(
            id: "rocket-session",
            name: "User Session & Authorization Service",
            description: "User context, elevation grants, and multi-user authentication",
            startup_mode: StartupMode.Boot,
            dependencies: ["rocket-init"],
            is_critical: true,
            assigned_uid: 0
        ),
        ServiceDefinition(
            id: "rocket-fs",
