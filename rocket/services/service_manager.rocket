            description: "Web Audio synthesis driver, acoustic events, and volume controller",
            startup_mode: StartupMode.Boot,
            dependencies: ["rocket-settings"],
            is_critical: false,
            assigned_uid: 1000
        ),
        ServiceDefinition(
            id: "rocket-network",
