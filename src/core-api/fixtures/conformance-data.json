    { "extension": ".txt", "defaultAppId": "notes" },
    { "extension": ".png", "defaultAppId": "gallery" }
  ],
  "shellParsing": [
    { "commandLine": "ls -la", "expectedNodes": 1, "firstCommand": "ls" },
    { "commandLine": "cat /etc/os-release | grep VERSION", "expectedNodes": 2, "firstCommand": "cat" },
    { "commandLine": "echo 'Hello Rocket' > /tmp/out.txt", "expectedNodes": 1, "firstCommand": "echo" }
