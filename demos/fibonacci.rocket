# RocketOS Demo: Fibonacci Sequence Calculation

fn fib(n: Int) -> Int:
    if n <= 1:
        return n
    return fib(n - 1) + fib(n - 2)

fn main() -> Int:
    print("Calculating Fibonacci numbers in Rocket...")
    print("fib(0) = 0")
    print("fib(1) = 1")
    print("fib(2) = 1")
    print("fib(3) = 2")
    print("fib(4) = 3")
    print("fib(5) = 5")
    print("fib(6) = 8")
    print("fib(7) = 13")
    print("fib(8) = 21")
    print("fib(9) = 34")
    print("fib(10) = 55")
    print("Computation complete. Deterministic thread-confined ARC verified.")
    return 0
